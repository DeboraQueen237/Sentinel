@page "/settings"
@inject SentinelApiClient Api
@inject ToastService Toasts

<PageTitle>Paramètres — SENTINEL</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Paramètres SENTINEL</h1>
        <p class="page-subtitle">Configuration du mode de décision, seuils de menace, exclusions, IA locale Ollama et moteur de corrélation</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn" @onclick="LoadAsync" disabled="@_loading">Recharger</button>
        <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@(_saving || !_dirty)">
            @(_saving ? "Enregistrement…" : "Enregistrer")
        </button>
    </div>
</div>

<ErrorBanner Message="@_error" OnRetry="LoadAsync" />

@if (_loading && _settings is null)
{
    <SkeletonCards Count="4" />
}
else if (_settings is not null)
{
    <div class="stack-md">
        <!-- 1. Mode de fonctionnement -->
        <section class="card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">Mode de fonctionnement</h2>
                    <p class="card-subtitle">Contrôle l'exécution effective des mesures de réponse par les agents (§9.4)</p>
                </div>
            </div>

            <div class="mode-cards" style="margin-bottom:16px;">
                @foreach (var mode in Enum.GetValues<OperatingMode>())
                {
                    var selected = _settings.Mode == mode;
                    <button type="button"
                            class="mode-card @UiFormatters.OperatingModeCss(mode) @(selected ? "selected" : "")"
                            @onclick="() => SelectMode(mode)">
                        <div class="row-wrap" style="justify-content:space-between;margin-bottom:6px;">
                            <strong style="font-size:15px;">@UiFormatters.OperatingModeLabel(mode)</strong>
                            @if (selected)
                            {
                                <span class="badge @UiFormatters.OperatingModeCss(mode)">Actif</span>
                            }
                        </div>
                        <div class="text-secondary" style="font-size:12.5px;line-height:1.45;">
                            @UiFormatters.OperatingModeDescription(mode)
                        </div>
                    </button>
                }
            </div>

            <div class="grid-2">
                <div class="field">
                    <label class="field-label">Durée d'apprentissage initiale (jours)</label>
                    <input type="number" class="input mono" min="1" max="60"
                           @bind="_settings.LearningPeriodDays" @bind:after="MarkDirty" />
                    <span class="field-hint">Démarré le @UiFormatters.FormatShortDateTime(_settings.LearningStartedAt)</span>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Passage automatique en mode Actif</div>
                        <div class="field-hint">Quitte automatiquement le mode Apprentissage après @_settings.LearningPeriodDays jour(s)</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.AutoLeaveLearning" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>
            </div>
        </section>

        <!-- 2. Seuils de menace -->
        <section class="card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">Seuils de menace (0 – 100)</h2>
                    <p class="card-subtitle">Détermine le déclenchement des notifications, alertes niveau 3 et blocages critiques niveau 4 (§9.1)</p>
                </div>
            </div>

            @{
                var t = _settings.Thresholds;
                var wInfo = Math.Clamp(t.Low, 0, 100);
                var wLow = Math.Max(0, t.Moderate - t.Low);
                var wMod = Math.Max(0, t.High - t.Moderate);
                var wHigh = Math.Max(0, t.Critical - t.High);
                var wCrit = Math.Max(0, 100 - t.Critical);
            }

            <div class="threshold-spectrum" aria-label="Spectre gradué des seuils">
                <div class="threshold-seg" style="width:@(wInfo)%;background:#38bdf8;" title="Info : 0 – @(t.Low - 1)"></div>
                <div class="threshold-seg" style="width:@(wLow)%;background:#06b6d4;" title="Faible : @t.Low – @(t.Moderate - 1)"></div>
                <div class="threshold-seg" style="width:@(wMod)%;background:#f59e0b;" title="Modéré : @t.Moderate – @(t.High - 1)"></div>
                <div class="threshold-seg" style="width:@(wHigh)%;background:#f97316;" title="Élevé : @t.High – @(t.Critical - 1)"></div>
                <div class="threshold-seg" style="width:@(wCrit)%;background:#ef4444;" title="Critique : @t.Critical – 100"></div>
            </div>
            <div class="row-wrap text-muted mono" style="justify-content:space-between;font-size:11px;margin-bottom:16px;">
                <span>0 (Info)</span>
                <span>Faible ≥ @t.Low</span>
                <span>Modéré ≥ @t.Moderate</span>
                <span>Élevé ≥ @t.High</span>
                <span>Critique ≥ @t.Critical</span>
                <span>100</span>
            </div>

            <div class="grid-2">
                <div class="field">
                    <label class="field-label">Seuil Faible (Marquage corrélation) : <strong class="mono text-cyan">@t.Low</strong></label>
                    <input type="range" class="range-slider" min="10" max="60" value="@t.Low"
                           @oninput="e => UpdateThreshold(nameof(t.Low), e.Value)" />
                </div>
                <div class="field">
                    <label class="field-label">Seuil Modéré (Notification utilisateur) : <strong class="mono text-amber">@t.Moderate</strong></label>
                    <input type="range" class="range-slider" min="20" max="75" value="@t.Moderate"
                           @oninput="e => UpdateThreshold(nameof(t.Moderate), e.Value)" />
                </div>
                <div class="field">
                    <label class="field-label">Seuil Élevé (Alerte admin + décision) : <strong class="mono" style="color:var(--accent-orange);">@t.High</strong></label>
                    <input type="range" class="range-slider" min="40" max="90" value="@t.High"
                           @oninput="e => UpdateThreshold(nameof(t.High), e.Value)" />
                </div>
                <div class="field">
                    <label class="field-label">Seuil Critique (Blocage automatique réversible) : <strong class="mono text-crimson">@t.Critical</strong></label>
                    <input type="range" class="range-slider" min="60" max="99" value="@t.Critical"
                           @oninput="e => UpdateThreshold(nameof(t.Critical), e.Value)" />
                </div>
            </div>
        </section>

        <!-- 3. Collecteurs & Dossiers surveillés -->
        <section class="card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">Collecteurs &amp; Dossiers surveillés</h2>
                    <p class="card-subtitle">Liste fermée de canaux de collecte respectant la vie privée (§2.1 — aucun keylogger, aucun contenu stocké)</p>
                </div>
            </div>

            <div class="grid-2" style="margin-bottom:16px;">
                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Surveillance du presse-papiers</div>
                        <div class="field-hint">Détecte URLs suspectes et commandes copiées (seul le hash + domaine est conservé)</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.EnableClipboardMonitoring" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Dynamique de saisie (anti-BadUSB)</div>
                        <div class="field-hint">Statistiques de rythme uniquement — aucune touche frappée enregistrée</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.EnableTypingRhythm" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Extension navigateur</div>
                        <div class="field-hint">Domaines visités, liens cliqués, redirections et téléchargements</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.EnableBrowserMonitoring" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Surveillance réseau</div>
                        <div class="field-hint">Connexions actives, résolutions DNS et anomalies de volume</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.EnableNetworkMonitoring" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Collecteur Microsoft Defender (WMI + Journal)</div>
                        <div class="field-hint">Détections antivirus et alertes d'affaiblissement Defender (M1)</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.EnableDefenderCollector" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Collecteur Sysmon optionnel</div>
                        <div class="field-hint">Lit Microsoft-Windows-Sysmon/Operational uniquement si Sysmon est installé (non embarqué)</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.EnableSysmonCollector" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Fichiers canari anti-ransomware (M6)</div>
                        <div class="field-hint">Déploie des fichiers leurres suivis par empreinte SHA-256</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.Canaries.Enabled" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Visibilité scripts PowerShell 4104 / ETW AMSI (M7)</div>
                        <div class="field-hint">Inspecte en mémoire (métadonnées + hash par défaut, sans fournisseur AMSI managé)</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.ScriptVisibility.Enabled" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Conserver un extrait nettoyé de script suspect (≤ 300 car.)</div>
                        <div class="field-hint">Désactivé par défaut pour confidentialité maximale ; secrets automatiquement caviardés</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.ScriptVisibility.StoreSanitizedExcerpt" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Moteurs Sigma / YARA / ML PE (M2, M3, M5)</div>
                        <div class="field-hint">Évaluation locale multi-moteurs avec rechargement à chaud</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.Rules.EnableSigma" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>
            </div>

            <StringListEditor Label="Dossiers surveillés (FileSystemWatcher)"
                              Placeholder="%USERPROFILE%\Downloads"
                              Hint="Supporte les variables d'environnement Windows (%USERPROFILE%, %TEMP%…)."
                              Items="_settings.WatchedFolders"
                              OnChanged="MarkDirty" />
        </section>

        <!-- 4. Exclusions anti-faux-positifs -->
        <section class="card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">Exclusions anti-faux-positifs</h2>
                    <p class="card-subtitle">Liste blanche appliquée dès le pré-filtre déterministe (§7.1, §9.4)</p>
                </div>
            </div>

            <div class="grid-2">
                <StringListEditor Label="Processus exclus" Placeholder="ex. devenv.exe"
                                  Items="_settings.ExcludedProcesses" OnChanged="MarkDirty" />
                <StringListEditor Label="Domaines de confiance" Placeholder="ex. entreprise.local"
                                  Items="_settings.ExcludedDomains" OnChanged="MarkDirty" />
                <StringListEditor Label="Hashes SHA-256 approuvés" Placeholder="Empreinte SHA-256 hexadécimale"
                                  Items="_settings.ExcludedHashes" OnChanged="MarkDirty" />
                <StringListEditor Label="Chemins exclus" Placeholder="ex. C:\OutilsInternes\"
                                  Items="_settings.ExcludedPaths" OnChanged="MarkDirty" />
            </div>
        </section>

        <!-- 5. IA Locale (Ollama — Sélection intelligente Qwen & Optimisation) -->
        <section class="card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">IA locale (Ollama — Auto-sélection Qwen &amp; Optimisation)</h2>
                    <p class="card-subtitle">Détecte automatiquement le meilleur modèle Qwen installé localement selon votre RAM et optimise la latence CPU/GPU (§7.1)</p>
                </div>
                <button type="button" class="btn btn-sm" @onclick="AutoSelectLlmAsync" disabled="@_selectingLlm">
                    @(_selectingLlm ? "Détection…" : "Re-détecter le meilleur Qwen")
                </button>
            </div>

            @if (_llmStatus is not null)
            {
                <div class="card" style="background:rgba(15,23,42,0.6);border:1px solid rgba(56,189,248,0.25);padding:12px 14px;margin-bottom:16px;">
                    <div class="row-wrap" style="justify-content:space-between;gap:12px;">
                        <div>
                            <span class="badge @(_llmStatus.Available ? "badge-emerald" : "badge-amber")">
                                @(_llmStatus.Available ? "Ollama en ligne" : "Ollama hors ligne (repli règles)")
                            </span>
                            <strong class="mono" style="margin-left:8px;color:var(--accent-cyan);">@_llmStatus.ActiveModel</strong>
                            @if (_llmStatus.AutoSelected)
                            {
                                <span class="badge" style="margin-left:6px;">Auto-sélectionné</span>
                            }
                            @if (_llmStatus.WarmedUp)
                            {
                                <span class="badge badge-emerald" style="margin-left:6px;">Préchargé en mémoire</span>
                            }
                        </div>
                        <div class="text-muted mono" style="font-size:12px;">
                            RAM : @_llmStatus.HostRamGb.ToString("F1") Go · Appels : @_llmStatus.Calls · Cache hits : @_llmStatus.CacheHits · Latence moy. : @_llmStatus.AvgLatencyMs.ToString("F0") ms
                        </div>
                    </div>
                    <div class="text-secondary" style="font-size:12.5px;margin-top:6px;">@_llmStatus.SelectionReason</div>
                    @if (_llmStatus.InstalledModels.Count > 0)
                    {
                        <div class="row-wrap" style="gap:6px;margin-top:8px;">
                            @foreach (var m in _llmStatus.InstalledModels)
                            {
                                var gb = m.SizeBytes > 0 ? $" ({m.SizeBytes / (1024.0 * 1024.0 * 1024.0):F1} Go)" : string.Empty;
                                <span class="badge @(m.Selected ? "badge-emerald" : (m.IsQwen ? "badge-cyan" : ""))" title="@(m.ParameterSize ?? m.Family)">
                                    @m.Name@gb@(m.Selected ? " ✓" : "")
                                </span>
                            }
                        </div>
                    }
                </div>
            }

            <div class="grid-2" style="margin-bottom:16px;">
                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Activer le scoring contextuel par LLM local</div>
                        <div class="field-hint">Bascule instantanément sur les règles déterministes si Ollama est indisponible.</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.Llm.Enabled" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Sélection automatique du meilleur modèle Qwen local</div>
                        <div class="field-hint">Choisit le Qwen le plus performant déjà présent sur le PC sans dépasser votre RAM (aucun téléchargement silencieux).</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.Llm.AutoSelectBestQwen" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Cache sémantique TTL des réponses LLM</div>
                        <div class="field-hint">Absorbe les rafales d'événements similaires en &lt; 0,1 ms sans solliciter Ollama.</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.Llm.EnableResponseCache" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Préchauffage du modèle au démarrage</div>
                        <div class="field-hint">Charge le modèle en mémoire avec keep_alive pour supprimer la latence à froid.</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.Llm.WarmUpOnStartup" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>
            </div>

            <div class="grid-3">
                <div class="field">
                    <label class="field-label">URL Ollama</label>
                    <input class="input mono" @bind="_settings.Llm.Endpoint" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label class="field-label">Modèle de secours / manuel</label>
                    <input class="input mono" @bind="_settings.Llm.Model" @bind:after="MarkDirty" />
                    <span class="field-hint">Ex. qwen2.5-coder:3b, qwen2.5:7b, qwen3:8b</span>
                </div>
                <div class="field">
                    <label class="field-label">Modèle d'embeddings</label>
                    <input class="input mono" @bind="_settings.Llm.EmbeddingModel" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label class="field-label">Bande d'ambiguïté — Bas : <strong class="mono">@_settings.Llm.AmbiguityLow</strong></label>
                    <input type="range" class="range-slider" min="0" max="70" @bind="_settings.Llm.AmbiguityLow" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label class="field-label">Bande d'ambiguïté — Haut : <strong class="mono">@_settings.Llm.AmbiguityHigh</strong></label>
                    <input type="range" class="range-slider" min="30" max="100" @bind="_settings.Llm.AmbiguityHigh" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label class="field-label">Timeout (secondes)</label>
                    <input type="number" class="input mono" min="2" max="60" @bind="_settings.Llm.TimeoutSeconds" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label class="field-label">Fenêtre de contexte (num_ctx)</label>
                    <input type="number" class="input mono" min="512" max="8192" step="256" @bind="_settings.Llm.ContextWindow" @bind:after="MarkDirty" />
                    <span class="field-hint">2048 recommandé sur CPU pour une réponse rapide.</span>
                </div>
                <div class="field">
                    <label class="field-label">Tokens max de sortie (num_predict)</label>
                    <input type="number" class="input mono" min="64" max="512" step="16" @bind="_settings.Llm.MaxOutputTokens" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label class="field-label">Maintien mémoire (keep_alive) / Cache (min)</label>
                    <div style="display:flex;gap:8px;">
                        <input class="input mono" placeholder="10m" title="keep_alive" @bind="_settings.Llm.KeepAlive" @bind:after="MarkDirty" />
                        <input type="number" class="input mono" min="1" max="60" title="TTL cache (min)" @bind="_settings.Llm.CacheTtlMinutes" @bind:after="MarkDirty" />
                    </div>
                </div>
                <div class="field">
                    <label class="field-label">Confiance minimale (0 – 1)</label>
                    <input type="number" class="input mono" step="0.05" min="0" max="1" @bind="_settings.Llm.MinConfidence" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label class="field-label">Appels simultanés max</label>
                    <input type="number" class="input mono" min="1" max="8" @bind="_settings.Llm.MaxConcurrency" @bind:after="MarkDirty" />
                </div>
            </div>
        </section>

        <!-- 5b. Notifications administrateur par niveau de criticité (In-App + Email + SMS + WhatsApp + Webhook) -->
        <section class="card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">Notifications administrateur par criticité (In-App, Email, SMS, WhatsApp, Slack / Teams / Telegram)</h2>
                    <p class="card-subtitle">Centre In-App actif en temps réel par défaut · Canaux externes opt-in · Métadonnées uniquement · Secrets chiffrés DPAPI</p>
                </div>
                <div class="row-wrap" style="gap:8px;">
                    <button type="button" class="btn btn-sm btn-primary" @onclick='() => TestNotificationAsync("inapp")' disabled="@_testingChannel">
                        🔔 Tester Notification App
                    </button>
                    <button type="button" class="btn btn-sm" @onclick="RefreshNotifStatusAsync">Actualiser</button>
                </div>
            </div>

            <div class="grid-3" style="margin-bottom:16px;">
                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Notifications temps réel dans l'application (Cloche + Son)</div>
                        <div class="field-hint">Affiche immédiatement chaque alerte ou cluster corrélé dans la barre supérieure.</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.Notifications.EnableInApp" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Activer les canaux externes (Email, SMS, WhatsApp, Webhook)</div>
                        <div class="field-hint">Interrupteur maître des envois hors console locale.</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.Notifications.Enabled" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Notifier également sur les clusters corrélés</div>
                        <div class="field-hint">Déclenche une alerte dès qu'une chaîne d'événements corrélés atteint le niveau requis.</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.Notifications.NotifyOnCorrelatedCluster" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>
            </div>

            <div class="grid-3" style="margin-bottom:18px;">
                <div class="field">
                    <label class="field-label">Délai anti-spam / cooldown (minutes)</label>
                    <input type="number" class="input mono" min="0" max="1440" @bind="_settings.Notifications.CooldownMinutes" @bind:after="MarkDirty" />
                    <span class="field-hint">Contourné immédiatement en cas d'escalade (ex. Élevé → Critique).</span>
                </div>
                <div class="field">
                    <label class="field-label">URL console locale dans les alertes</label>
                    <input class="input mono" @bind="_settings.Notifications.DashboardBaseUrl" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label class="field-label">Statistiques de diffusion</label>
                    <div class="text-secondary mono" style="font-size:12.5px;padding-top:8px;">
                        @if (_notifStatus is not null)
                        {
                            <span>Envoyées : @_notifStatus.TotalSent · Échecs : @_notifStatus.TotalFailed · Cooldown : @_notifStatus.SuppressedByCooldown</span>
                        }
                        else
                        {
                            <span>Chargement…</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Canaux individuels -->
            <div class="stack-md">
                <!-- Email SMTP -->
                <div class="card" style="background:rgba(15,23,42,0.45);padding:14px;">
                    <div class="row-wrap" style="justify-content:space-between;margin-bottom:12px;">
                        <div class="row-wrap" style="gap:10px;">
                            <strong>Email (SMTP TLS / STARTTLS)</strong>
                            @if (_notifStatus?.Secrets.HasSmtpPassword == true)
                            {
                                <span class="badge badge-emerald">Mot de passe DPAPI enregistré</span>
                            }
                        </div>
                        <div class="row-wrap" style="gap:10px;">
                            <button type="button" class="btn btn-sm" @onclick='() => TestNotificationAsync("email")' disabled="@_testingChannel">
                                Tester Email
                            </button>
                            <label class="switch">
                                <input type="checkbox" @bind="_settings.Notifications.Email.Enabled" @bind:after="MarkDirty" />
                                <span class="switch-track"></span>
                            </label>
                        </div>
                    </div>
                    <div class="grid-3">
                        <div class="field">
                            <label class="field-label">Criticité minimale</label>
                            <select class="input" @bind="_settings.Notifications.Email.MinLevel" @bind:after="MarkDirty">
                                <option value="@ThreatLevel.Low">Faible (≥ 30)</option>
                                <option value="@ThreatLevel.Moderate">Modéré (≥ 55)</option>
                                <option value="@ThreatLevel.High">Élevé (≥ 75)</option>
                                <option value="@ThreatLevel.Critical">Critique (≥ 90)</option>
                            </select>
                        </div>
                        <div class="field">
                            <label class="field-label">Serveur SMTP</label>
                            <input class="input mono" placeholder="smtp.gmail.com" @bind="_settings.Notifications.Email.SmtpHost" @bind:after="MarkDirty" />
                        </div>
                        <div class="field">
                            <label class="field-label">Port SMTP &amp; STARTTLS</label>
                            <div style="display:flex;gap:8px;align-items:center;">
                                <input type="number" class="input mono" min="1" max="65535" @bind="_settings.Notifications.Email.SmtpPort" @bind:after="MarkDirty" />
                                <label style="display:flex;gap:4px;font-size:12px;white-space:nowrap;">
                                    <input type="checkbox" @bind="_settings.Notifications.Email.UseStartTls" @bind:after="MarkDirty" /> TLS
                                </label>
                            </div>
                        </div>
                        <div class="field">
                            <label class="field-label">Adresse expéditeur</label>
                            <input class="input mono" placeholder="sentinel-soc@entreprise.local" @bind="_settings.Notifications.Email.FromAddress" @bind:after="MarkDirty" />
                        </div>
                        <div class="field">
                            <label class="field-label">Identifiant SMTP (login)</label>
                            <input class="input mono" placeholder="utilisateur@domaine.com" @bind="_settings.Notifications.Email.Username" @bind:after="MarkDirty" />
                        </div>
                        <div class="field">
                            <label class="field-label">Mot de passe SMTP (chiffré DPAPI)</label>
                            <input type="password" class="input" placeholder="Laisser vide pour conserver l'actuel" @bind="_smtpPasswordInput" />
                        </div>
                    </div>
                    <div style="margin-top:10px;">
                        <StringListEditor Label="Destinataires Email administrateurs"
                                          Placeholder="soc-admin@entreprise.com"
                                          Items="_settings.Notifications.Email.Recipients"
                                          OnChanged="MarkDirty" />
                    </div>
                </div>

                <!-- SMS -->
                <div class="card" style="background:rgba(15,23,42,0.45);padding:14px;">
                    <div class="row-wrap" style="justify-content:space-between;margin-bottom:12px;">
                        <div class="row-wrap" style="gap:10px;">
                            <strong>SMS (Twilio SMS ou Passerelle HTTP / Opérateur)</strong>
                            @if (_notifStatus?.Secrets.HasSmsToken == true)
                            {
                                <span class="badge badge-emerald">Jeton SMS DPAPI enregistré</span>
                            }
                        </div>
                        <div class="row-wrap" style="gap:10px;">
                            <button type="button" class="btn btn-sm" @onclick='() => TestNotificationAsync("sms")' disabled="@_testingChannel">
                                Tester SMS
                            </button>
                            <label class="switch">
                                <input type="checkbox" @bind="_settings.Notifications.Sms.Enabled" @bind:after="MarkDirty" />
                                <span class="switch-track"></span>
                            </label>
                        </div>
                    </div>
                    <div class="grid-3">
                        <div class="field">
                            <label class="field-label">Criticité minimale</label>
                            <select class="input" @bind="_settings.Notifications.Sms.MinLevel" @bind:after="MarkDirty">
                                <option value="@ThreatLevel.Low">Faible (≥ 30)</option>
                                <option value="@ThreatLevel.Moderate">Modéré (≥ 55)</option>
                                <option value="@ThreatLevel.High">Élevé (≥ 75)</option>
                                <option value="@ThreatLevel.Critical">Critique (≥ 90)</option>
                            </select>
                        </div>
                        <div class="field">
                            <label class="field-label">Fournisseur SMS</label>
                            <select class="input" @bind="_settings.Notifications.Sms.Provider" @bind:after="MarkDirty">
                                <option value="TwilioSms">Twilio SMS</option>
                                <option value="HttpGateway">Passerelle HTTP (Orange / Africa's Talking / OVH)</option>
                            </select>
                        </div>
                        @if (string.Equals(_settings.Notifications.Sms.Provider, "HttpGateway", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="field">
                                <label class="field-label">URL Passerelle SMS (HTTPS)</label>
                                <input class="input mono" placeholder="https://sms-gateway.exemple.cm/send" @bind="_settings.Notifications.Sms.GatewayUrl" @bind:after="MarkDirty" />
                            </div>
                        }
                        else
                        {
                            <div class="field">
                                <label class="field-label">Twilio Account SID</label>
                                <input class="input mono" placeholder="ACxxxxxxxxxxxxxxxx" @bind="_settings.Notifications.Sms.AccountSid" @bind:after="MarkDirty" />
                            </div>
                            <div class="field">
                                <label class="field-label">Numéro expéditeur SMS</label>
                                <input class="input mono" placeholder="+14155550100" @bind="_settings.Notifications.Sms.FromNumber" @bind:after="MarkDirty" />
                            </div>
                        }
                        <div class="field">
                            <label class="field-label">Clé API SMS / Auth Token (DPAPI)</label>
                            <input type="password" class="input" placeholder="Laisser vide pour conserver l'actuel" @bind="_smsTokenInput" />
                        </div>
                    </div>
                    <div style="margin-top:10px;">
                        <StringListEditor Label="Numéros SMS administrateurs (E.164)"
                                          Placeholder="+2376XXXXXXXX"
                                          Items="_settings.Notifications.Sms.Recipients"
                                          OnChanged="MarkDirty" />
                    </div>
                </div>

                <!-- WhatsApp -->
                <div class="card" style="background:rgba(15,23,42,0.45);padding:14px;">
                    <div class="row-wrap" style="justify-content:space-between;margin-bottom:12px;">
                        <div class="row-wrap" style="gap:10px;">
                            <strong>WhatsApp (Meta Cloud API ou Twilio)</strong>
                            @if (_notifStatus?.Secrets.HasWhatsAppToken == true)
                            {
                                <span class="badge badge-emerald">Jeton API DPAPI enregistré</span>
                            }
                        </div>
                        <div class="row-wrap" style="gap:10px;">
                            <button type="button" class="btn btn-sm" @onclick='() => TestNotificationAsync("whatsapp")' disabled="@_testingChannel">
                                Tester WhatsApp
                            </button>
                            <label class="switch">
                                <input type="checkbox" @bind="_settings.Notifications.WhatsApp.Enabled" @bind:after="MarkDirty" />
                                <span class="switch-track"></span>
                            </label>
                        </div>
                    </div>
                    <div class="grid-3">
                        <div class="field">
                            <label class="field-label">Criticité minimale</label>
                            <select class="input" @bind="_settings.Notifications.WhatsApp.MinLevel" @bind:after="MarkDirty">
                                <option value="@ThreatLevel.Low">Faible (≥ 30)</option>
                                <option value="@ThreatLevel.Moderate">Modéré (≥ 55)</option>
                                <option value="@ThreatLevel.High">Élevé (≥ 75)</option>
                                <option value="@ThreatLevel.Critical">Critique (≥ 90)</option>
                            </select>
                        </div>
                        <div class="field">
                            <label class="field-label">Fournisseur officiel</label>
                            <select class="input" @bind="_settings.Notifications.WhatsApp.Provider" @bind:after="MarkDirty">
                                <option value="MetaCloud">Meta WhatsApp Cloud API</option>
                                <option value="Twilio">Twilio WhatsApp API</option>
                            </select>
                        </div>
                        @if (string.Equals(_settings.Notifications.WhatsApp.Provider, "Twilio", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="field">
                                <label class="field-label">Twilio Account SID</label>
                                <input class="input mono" placeholder="ACxxxxxxxxxxxxxxxx" @bind="_settings.Notifications.WhatsApp.AccountSid" @bind:after="MarkDirty" />
                            </div>
                            <div class="field">
                                <label class="field-label">Numéro expéditeur Twilio</label>
                                <input class="input mono" placeholder="whatsapp:+14155238886" @bind="_settings.Notifications.WhatsApp.FromNumber" @bind:after="MarkDirty" />
                            </div>
                        }
                        else
                        {
                            <div class="field">
                                <label class="field-label">Meta Phone Number ID</label>
                                <input class="input mono" placeholder="123456789012345" @bind="_settings.Notifications.WhatsApp.PhoneNumberId" @bind:after="MarkDirty" />
                            </div>
                            <div class="field">
                                <label class="field-label">Version Graph API</label>
                                <input class="input mono" placeholder="v21.0" @bind="_settings.Notifications.WhatsApp.ApiVersion" @bind:after="MarkDirty" />
                            </div>
                        }
                        <div class="field">
                            <label class="field-label">Jeton d'accès / Auth Token (DPAPI)</label>
                            <input type="password" class="input" placeholder="Laisser vide pour conserver l'actuel" @bind="_whatsAppTokenInput" />
                        </div>
                    </div>
                    <div style="margin-top:10px;">
                        <StringListEditor Label="Numéros WhatsApp administrateurs (E.164)"
                                          Placeholder="+2376XXXXXXXX"
                                          Hint="Format international E.164 avec indicatif pays."
                                          Items="_settings.Notifications.WhatsApp.Recipients"
                                          OnChanged="MarkDirty" />
                    </div>
                </div>

                <!-- Webhook / Slack / Teams / Discord / Telegram -->
                <div class="card" style="background:rgba(15,23,42,0.45);padding:14px;">
                    <div class="row-wrap" style="justify-content:space-between;margin-bottom:12px;">
                        <div class="row-wrap" style="gap:10px;">
                            <strong>Webhook / Slack / Microsoft Teams / Discord / Telegram</strong>
                            @if (_notifStatus?.Secrets.HasWebhookSecret == true)
                            {
                                <span class="badge badge-emerald">Secret HMAC / Bot DPAPI enregistré</span>
                            }
                        </div>
                        <div class="row-wrap" style="gap:10px;">
                            <button type="button" class="btn btn-sm" @onclick='() => TestNotificationAsync("webhook")' disabled="@_testingChannel">
                                Tester Webhook
                            </button>
                            <label class="switch">
                                <input type="checkbox" @bind="_settings.Notifications.Webhook.Enabled" @bind:after="MarkDirty" />
                                <span class="switch-track"></span>
                            </label>
                        </div>
                    </div>
                    <div class="grid-3">
                        <div class="field">
                            <label class="field-label">Criticité minimale</label>
                            <select class="input" @bind="_settings.Notifications.Webhook.MinLevel" @bind:after="MarkDirty">
                                <option value="@ThreatLevel.Low">Faible (≥ 30)</option>
                                <option value="@ThreatLevel.Moderate">Modéré (≥ 55)</option>
                                <option value="@ThreatLevel.High">Élevé (≥ 75)</option>
                                <option value="@ThreatLevel.Critical">Critique (≥ 90)</option>
                            </select>
                        </div>
                        <div class="field">
                            <label class="field-label">Format</label>
                            <select class="input" @bind="_settings.Notifications.Webhook.Format" @bind:after="MarkDirty">
                                <option value="GenericJson">JSON générique (+ signature HMAC-SHA256)</option>
                                <option value="Slack">Slack Incoming Webhook</option>
                                <option value="Teams">Microsoft Teams (MessageCard)</option>
                                <option value="Discord">Discord Webhook</option>
                                <option value="Telegram">Telegram Bot API</option>
                            </select>
                        </div>
                        @if (string.Equals(_settings.Notifications.Webhook.Format, "Telegram", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="field">
                                <label class="field-label">Telegram Chat ID</label>
                                <input class="input mono" placeholder="-1001234567890" @bind="_settings.Notifications.Webhook.TelegramChatId" @bind:after="MarkDirty" />
                            </div>
                        }
                        else
                        {
                            <div class="field">
                                <label class="field-label">URL Webhook (HTTPS)</label>
                                <input class="input mono" placeholder="https://hooks.slack.com/services/..." @bind="_settings.Notifications.Webhook.Url" @bind:after="MarkDirty" />
                            </div>
                        }
                        <div class="field">
                            <label class="field-label">Clé HMAC-SHA256 / Jeton Bot Telegram (DPAPI)</label>
                            <input type="password" class="input" placeholder="Laisser vide pour conserver l'actuel" @bind="_webhookSecretInput" />
                        </div>
                    </div>
                </div>

                <div class="row-wrap" style="justify-content:space-between;align-items:center;">
                    <span class="field-hint">
                        Stockage sécurisé des identifiants : @(_notifStatus?.Secrets.StorageMode ?? "DPAPI Windows"). Aucun mot de passe n'est stocké dans SQLite.
                    </span>
                    <button type="button" class="btn btn-amber" @onclick="SaveNotificationSecretsAsync" disabled="@_savingSecrets">
                        @(_savingSecrets ? "Chiffrement…" : "Enregistrer les secrets (DPAPI)")
                    </button>
                </div>

                @if (_notifStatus is { RecentDeliveries.Count: > 0 })
                {
                    <div style="margin-top:8px;">
                        <div style="font-weight:600;margin-bottom:6px;font-size:13px;">Historique récent des notifications</div>
                        <div class="table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Canal</th>
                                        <th>Déclencheur</th>
                                        <th>Criticité</th>
                                        <th>Poste</th>
                                        <th>Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in _notifStatus.RecentDeliveries.Take(10))
                                    {
                                        <tr>
                                            <td class="mono">@UiFormatters.FormatShortDateTime(d.Timestamp)</td>
                                            <td class="mono">@d.Channel</td>
                                            <td>@d.TriggerKind</td>
                                            <td><span class="badge">@d.Level</span></td>
                                            <td class="mono">@d.HostId</td>
                                            <td>
                                                @if (d.Success)
                                                {
                                                    <span class="badge badge-emerald">OK (@d.ElapsedMs.ToString("F0") ms)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-crimson" title="@d.Error">Échec : @(d.Error ?? "Erreur")</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- 6. Moteur de corrélation -->
        <section class="card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">Moteur de corrélation (§8)</h2>
                    <p class="card-subtitle">Fenêtres glissantes, décroissance exponentielle et escalade précoce au 2ᵉ événement</p>
                </div>
            </div>

            <div class="grid-2" style="margin-bottom:16px;">
                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Activer le moteur de corrélation</div>
                        <div class="field-hint">Relie les signaux faibles en clusters et chaînes d'attaque</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.Correlation.Enabled" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div style="font-weight:600;">Escalade précoce (2ᵉ événement similaire)</div>
                        <div class="field-hint">Relève le niveau d'un cran dès la répétition d'un signal dans un même contexte (§8.2-5)</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="_settings.Correlation.EarlyEscalation" @bind:after="MarkDirty" />
                        <span class="switch-track"></span>
                    </label>
                </div>
            </div>

            <div class="grid-3">
                <div class="field">
                    <label class="field-label">Fenêtre courte (min)</label>
                    <input type="number" class="input mono" min="1" max="60" @bind="_settings.Correlation.ShortWindowMinutes" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label class="field-label">Fenêtre moyenne (min)</label>
                    <input type="number" class="input mono" min="5" max="240" @bind="_settings.Correlation.MediumWindowMinutes" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label class="field-label">Fenêtre longue (heures)</label>
                    <input type="number" class="input mono" min="1" max="168" @bind="_settings.Correlation.LongWindowHours" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label class="field-label">Score min d'entrée corrélation</label>
                    <input type="number" class="input mono" min="0" max="90" @bind="_settings.Correlation.MinEventScore" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label class="field-label">Demi-vie décroissance (min)</label>
                    <input type="number" class="input mono" step="1" min="1" max="240" @bind="_settings.Correlation.DecayHalfLifeMinutes" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label class="field-label">Poids même entité / même type</label>
                    <div style="display:flex;gap:8px;">
                        <input type="number" class="input mono" step="0.05" min="0.1" max="1" title="Même entité"
                               @bind="_settings.Correlation.SameEntityWeight" @bind:after="MarkDirty" />
                        <input type="number" class="input mono" step="0.05" min="0.05" max="1" title="Même type"
                               @bind="_settings.Correlation.SameTypeWeight" @bind:after="MarkDirty" />
                    </div>
                </div>
            </div>
        </section>

        <!-- 7. Rétention & Compte administrateur -->
        <div class="grid-2">
            <section class="card">
                <div class="card-header">
                    <div>
                        <h2 class="card-title">Politique de rétention (§2.3)</h2>
                        <p class="card-subtitle">Purge automatique des données au-delà de la durée configurée</p>
                    </div>
                </div>
                <div class="stack-md">
                    <div class="field">
                        <label class="field-label">Rétention des événements bruts (jours)</label>
                        <input type="number" class="input mono" min="7" max="730" @bind="_settings.EventRetentionDays" @bind:after="MarkDirty" />
                        <span class="field-hint">Valeur recommandée par la documentation : 90 jours.</span>
                    </div>
                    <div class="field">
                        <label class="field-label">Rétention des alertes &amp; incidents (jours)</label>
                        <input type="number" class="input mono" min="30" max="1825" @bind="_settings.AlertRetentionDays" @bind:after="MarkDirty" />
                        <span class="field-hint">Valeur recommandée : 365 jours (12 mois).</span>
                    </div>
                </div>
            </section>

            <section class="card">
                <div class="card-header">
                    <div>
                        <h2 class="card-title">Compte administrateur — Mot de passe</h2>
                        <p class="card-subtitle">Confirmation par code TOTP obligatoire (§10.2)</p>
                    </div>
                </div>

                <form @onsubmit="ChangePasswordAsync" class="stack-sm">
                    <div class="field">
                        <label class="field-label">Mot de passe actuel</label>
                        <input type="password" class="input" @bind="_curPwd" required />
                    </div>
                    <div class="field">
                        <label class="field-label">Nouveau mot de passe</label>
                        <input type="password" class="input" @bind="_newPwd" required />
                    </div>
                    <div class="field">
                        <label class="field-label">Confirmation</label>
                        <input type="password" class="input" @bind="_confirmPwd" required />
                    </div>
                    <div class="field">
                        <label class="field-label">Code TOTP (6 chiffres)</label>
                        <input class="input mono" maxlength="6" inputmode="numeric" placeholder="000000" @bind="_pwdTotp" required />
                    </div>
                    <button type="submit" class="btn btn-amber" disabled="@_changingPwd" style="margin-top:4px;">
                        @(_changingPwd ? "Mise à jour…" : "Modifier le mot de passe")
                    </button>
                </form>
            </section>
        </div>
    </div>

    @if (_dirty)
    {
        <div class="sticky-save-bar">
            <div>
                <strong style="color:var(--accent-cyan);">Modifications non enregistrées</strong>
                <div class="text-secondary" style="font-size:12px;">Les nouveaux paramètres seront appliqués au serveur et diffusés aux agents.</div>
            </div>
            <div class="row-wrap">
                <button type="button" class="btn" @onclick="LoadAsync" disabled="@_saving">Annuler</button>
                <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @(_saving ? "Enregistrement…" : "Enregistrer les modifications")
                </button>
            </div>
        </div>
    }
}

@code {
    private SentinelSettings? _settings;
    private LlmStatusDto? _llmStatus;
    private NotificationStatusDto? _notifStatus;
    private bool _loading = true;
    private bool _saving;
    private bool _dirty;
    private bool _selectingLlm;
    private bool _testingChannel;
    private bool _savingSecrets;
    private string? _error;

    private string _smtpPasswordInput = string.Empty;
    private string _smsTokenInput = string.Empty;
    private string _whatsAppTokenInput = string.Empty;
    private string _webhookSecretInput = string.Empty;

    private string _curPwd = string.Empty;
    private string _newPwd = string.Empty;
    private string _confirmPwd = string.Empty;
    private string _pwdTotp = string.Empty;
    private bool _changingPwd;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _settings = await Api.GetSettingsAsync();
            _settings.Notifications ??= new NotificationSettings();
            _settings.Notifications.Sms ??= new SmsNotificationSettings();
            _dirty = false;
            try { _llmStatus = await Api.GetLlmStatusAsync(); } catch { /* optionnel */ }
            try { _notifStatus = await Api.GetNotificationStatusAsync(); } catch { /* optionnel */ }
        }
        catch (SentinelApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task AutoSelectLlmAsync()
    {
        _selectingLlm = true;
        try
        {
            _llmStatus = await Api.AutoSelectLlmModelAsync();
            Toasts.Success("Détection Ollama terminée", _llmStatus.SelectionReason);
        }
        catch (SentinelApiException ex)
        {
            Toasts.Danger("Échec détection Ollama", ex.Message);
        }
        finally
        {
            _selectingLlm = false;
        }
    }

    private async Task RefreshNotifStatusAsync()
    {
        try
        {
            _notifStatus = await Api.GetNotificationStatusAsync();
        }
        catch (SentinelApiException ex)
        {
            Toasts.Warning("Statut indisponible", ex.Message);
        }
    }

    private async Task SaveNotificationSecretsAsync()
    {
        if (string.IsNullOrWhiteSpace(_smtpPasswordInput) &&
            string.IsNullOrWhiteSpace(_smsTokenInput) &&
            string.IsNullOrWhiteSpace(_whatsAppTokenInput) &&
            string.IsNullOrWhiteSpace(_webhookSecretInput))
        {
            Toasts.Warning("Aucun secret saisi", "Saisissez au moins un mot de passe SMTP, une clé SMS, un jeton WhatsApp ou un secret Webhook.");
            return;
        }

        _savingSecrets = true;
        try
        {
            await Api.UpdateNotificationSecretsAsync(new NotificationSecretsRequest(
                SmtpPassword: string.IsNullOrWhiteSpace(_smtpPasswordInput) ? null : _smtpPasswordInput,
                WhatsAppAccessToken: string.IsNullOrWhiteSpace(_whatsAppTokenInput) ? null : _whatsAppTokenInput,
                WebhookSecret: string.IsNullOrWhiteSpace(_webhookSecretInput) ? null : _webhookSecretInput,
                SmsApiToken: string.IsNullOrWhiteSpace(_smsTokenInput) ? null : _smsTokenInput));

            _smtpPasswordInput = _smsTokenInput = _whatsAppTokenInput = _webhookSecretInput = string.Empty;
            await RefreshNotifStatusAsync();
            Toasts.Success("Secrets chiffrés (DPAPI)", "Les identifiants ont été enregistrés dans le coffre protégé local.");
        }
        catch (SentinelApiException ex)
        {
            Toasts.Danger("Échec enregistrement des secrets", ex.Message);
        }
        finally
        {
            _savingSecrets = false;
        }
    }

    private async Task TestNotificationAsync(string channel)
    {
        if (_dirty && _settings is not null)
        {
            await SaveAsync();
        }

        _testingChannel = true;
        try
        {
            var res = await Api.TestNotificationAsync(channel);
            await RefreshNotifStatusAsync();
            if (res.Success)
            {
                Toasts.Success($"Test {channel} réussi", $"Notification envoyée en {res.ElapsedMs:F0} ms.");
            }
            else
            {
                Toasts.Danger($"Test {channel} en échec", res.Error ?? "Vérifiez la configuration et les secrets DPAPI.");
            }
        }
        catch (SentinelApiException ex)
        {
            Toasts.Danger($"Erreur test {channel}", ex.Message);
        }
        finally
        {
            _testingChannel = false;
        }
    }

    private void MarkDirty() => _dirty = true;

    private void SelectMode(OperatingMode mode)
    {
        if (_settings is null) return;
        _settings.Mode = mode;
        _dirty = true;
    }

    private void UpdateThreshold(string field, object? raw)
    {
        if (_settings is null || !int.TryParse(raw?.ToString(), out var v)) return;
        var t = _settings.Thresholds;
        switch (field)
        {
            case nameof(ThreatThresholds.Low):
                t.Low = Math.Clamp(v, 5, Math.Max(5, t.Moderate - 5));
                break;
            case nameof(ThreatThresholds.Moderate):
                t.Moderate = Math.Clamp(v, t.Low + 5, Math.Max(t.Low + 5, t.High - 5));
                break;
            case nameof(ThreatThresholds.High):
                t.High = Math.Clamp(v, t.Moderate + 5, Math.Max(t.Moderate + 5, t.Critical - 5));
                break;
            case nameof(ThreatThresholds.Critical):
                t.Critical = Math.Clamp(v, t.High + 5, 99);
                break;
        }
        _dirty = true;
    }

    private async Task SaveAsync()
    {
        if (_settings is null) return;
        _saving = true;
        _error = null;
        try
        {
            _settings = await Api.SaveSettingsAsync(_settings);
            _dirty = false;
            try { _llmStatus = await Api.GetLlmStatusAsync(); } catch { /* ignoré */ }
            try { _notifStatus = await Api.GetNotificationStatusAsync(); } catch { /* ignoré */ }
            Toasts.Success("Paramètres enregistrés", "Configuration sauvegardée et appliquée au moteur SENTINEL.");
        }
        catch (SentinelApiException ex)
        {
            _error = ex.Message;
            Toasts.Danger("Échec de l'enregistrement", ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        if (_newPwd.Length < 10)
        {
            Toasts.Warning("Mot de passe trop court", "Utilisez au moins 10 caractères.");
            return;
        }
        if (_newPwd != _confirmPwd)
        {
            Toasts.Warning("Confirmation invalide", "Les nouveaux mots de passe ne correspondent pas.");
            return;
        }
        var totp = new string(_pwdTotp.Where(char.IsDigit).ToArray());
        if (totp.Length != 6)
        {
            Toasts.Warning("Code TOTP invalide", "Saisissez le code à 6 chiffres.");
            return;
        }

        _changingPwd = true;
        try
        {
            await Api.ChangePasswordAsync(new ChangePasswordRequest(_curPwd, _newPwd, totp));
            _curPwd = _newPwd = _confirmPwd = _pwdTotp = string.Empty;
            Toasts.Success("Mot de passe modifié", "Votre nouveau mot de passe administrateur est actif.");
        }
        catch (SentinelApiException ex)
        {
            Toasts.Danger("Modification refusée", ex.Message);
        }
        finally
        {
            _changingPwd = false;
        }
    }
}
