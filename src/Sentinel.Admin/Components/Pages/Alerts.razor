@page "/alerts"
@inject SentinelApiClient Api
@inject LiveHubClient Hub
@inject ToastService Toasts
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Alertes — SENTINEL</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Alertes de sécurité</h1>
        <p class="page-subtitle">Liste filtrable des détections individuelles et corrélées, mappées MITRE ATT&amp;CK</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-amber" @onclick="PurgeDuplicatesAsync" disabled="@_purging" title="Archive les alertes redondantes en doublon (ex. rafales AgentTampering)">
            @(_purging ? "Nettoyage…" : "🧹 Dédupliquer les alertes")
        </button>
        <button type="button" class="btn" @onclick="ResetFiltersAsync">Réinitialiser</button>
        <button type="button" class="btn btn-primary" @onclick="LoadAsync" disabled="@_loading">
            @(_loading ? "Chargement…" : "Actualiser")
        </button>
    </div>
</div>

<!-- Filtres rapides 1 clic -->
<div class="row-wrap" style="gap:8px;margin-bottom:12px;">
    <button type="button" class="btn btn-sm @(string.IsNullOrEmpty(_quickPreset) ? "btn-primary" : "")" @onclick='() => ApplyQuickPresetAsync("")'>Toutes (@(_result?.Total ?? 0))</button>
    <button type="button" class="btn btn-sm @(_quickPreset == "open-crit" ? "btn-danger" : "")" @onclick='() => ApplyQuickPresetAsync("open-crit")'>Critiques ouvertes</button>
    <button type="button" class="btn btn-sm @(_quickPreset == "open-high" ? "btn-amber" : "")" @onclick='() => ApplyQuickPresetAsync("open-high")'>Élevées ouvertes</button>
    <button type="button" class="btn btn-sm @(_quickPreset == "no-tamper" ? "btn-violet" : "")" @onclick='() => ApplyQuickPresetAsync("no-tamper")'>Hors bruit Watchdog</button>
</div>

<ErrorBanner Message="@_error" OnRetry="LoadAsync" />

<div class="filter-bar">
    <div class="field search-field">
        <label class="field-label">Recherche instantanée</label>
        <input class="input" placeholder="Titre, résumé, domaine, poste, utilisateur, MITRE…"
               @bind="_search" @bind:event="oninput" @bind:after="ApplyFiltersAsync" />
    </div>

    <div class="field">
        <label class="field-label">Statut</label>
        <select class="select" @bind="_statusFilter" @bind:after="ApplyFiltersAsync">
            <option value="">Tous les statuts</option>
            @foreach (var s in Enum.GetValues<AlertStatus>())
            {
                <option value="@s">@UiFormatters.AlertStatusLabel(s)</option>
            }
        </select>
    </div>

    <div class="field">
        <label class="field-label">Niveau</label>
        <select class="select" @bind="_levelFilter" @bind:after="ApplyFiltersAsync">
            <option value="">Tous les niveaux</option>
            @foreach (var l in Enum.GetValues<ThreatLevel>())
            {
                <option value="@l">@UiFormatters.ThreatLevelLabel(l)</option>
            }
        </select>
    </div>

    <div class="field">
        <label class="field-label">Type de menace</label>
        <select class="select" @bind="_typeFilter" @bind:after="ApplyFiltersAsync">
            <option value="">Tous les types</option>
            @foreach (var t in Enum.GetValues<ThreatType>().Where(x => x != ThreatType.None))
            {
                <option value="@t">@UiFormatters.ThreatTypeLabel(t)</option>
            }
        </select>
    </div>

    <div class="field">
        <label class="field-label">Poste</label>
        <select class="select" @bind="_hostFilter" @bind:after="ApplyFiltersAsync">
            <option value="">Tous les postes</option>
            @foreach (var h in _hosts)
            {
                <option value="@h.HostId">@h.MachineName (@h.HostId)</option>
            }
        </select>
    </div>

    <div class="field">
        <label class="field-label">Période</label>
        <select class="select" @bind="_windowFilter" @bind:after="ApplyFiltersAsync">
            <option value="all">Toute la période</option>
            <option value="24h">Dernières 24 h</option>
            <option value="7d">7 derniers jours</option>
            <option value="30d">30 derniers jours</option>
        </select>
    </div>

    <button type="button" class="btn btn-primary" @onclick="ApplyFiltersAsync">Filtrer</button>
</div>

@if (_loading && _result is null)
{
    <SkeletonCards Count="4" />
}
else if (_result is null || _result.Items.Count == 0)
{
    <div class="card">
        <EmptyState Title="Aucune alerte ne correspond à ces critères"
                    Subtitle="Essayez d'élargir la période ou de réinitialiser vos filtres.">
            <button type="button" class="btn" style="margin-top:8px;" @onclick="ResetFiltersAsync">Afficher toutes les alertes</button>
        </EmptyState>
    </div>
}
else
{
    <div class="table-scroll">
        <table class="soc-table">
            <thead>
                <tr>
                    <th>Score</th>
                    <th>Niveau</th>
                    <th>Alerte &amp; contexte</th>
                    <th>Type</th>
                    <th>Poste / Utilisateur</th>
                    <th>MITRE ATT&amp;CK</th>
                    <th>Statut</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alert in FilteredClientItems)
                {
                    <tr class="clickable" @onclick='() => Nav.NavigateTo($"/alerts/{alert.Id}")'>
                        <td><ScoreBar Score="alert.Score" /></td>
                        <td><SeverityBadge Level="alert.Level" /></td>
                        <td style="max-width:270px;">
                            <div style="font-weight:700;color:var(--text-primary);" class="truncate">@alert.Title</div>
                            <div class="text-secondary truncate" style="font-size:12px;">@alert.Summary</div>
                            <div class="text-muted" style="font-size:11px;margin-top:2px;">
                                @alert.EventCount événement(s)
                                @if (alert.PendingActions > 0)
                                {
                                    <span> • <strong class="text-amber">@alert.PendingActions action(s) en attente</strong></span>
                                }
                            </div>
                        </td>
                        <td><span style="font-weight:600;">@UiFormatters.ThreatTypeLabel(alert.ThreatType)</span></td>
                        <td>
                            <div class="mono" style="font-size:12px;font-weight:600;">@alert.HostId</div>
                            <div class="text-muted" style="font-size:11.5px;">@alert.UserId</div>
                        </td>
                        <td><MitreChips Techniques="alert.MitreTechniques" MaxVisible="3" /></td>
                        <td>
                            <div class="stack-sm" style="gap:4px;align-items:flex-start;">
                                <span class="badge @UiFormatters.AlertStatusCss(alert.Status)">@UiFormatters.AlertStatusLabel(alert.Status)</span>
                                @if (alert.RequiresDecision && alert.Status == AlertStatus.Open)
                                {
                                    <span class="badge act-proposed" style="font-size:10.5px;">Décision requise</span>
                                }
                            </div>
                        </td>
                        <td class="mono" style="white-space:nowrap;font-size:12px;">
                            <div>@UiFormatters.FormatShortDateTime(alert.CreatedAt)</div>
                            <div class="text-muted" style="font-size:11px;">@UiFormatters.RelativeTime(alert.CreatedAt)</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Pagination Page="_page" PageSize="PageSize" Total="_result.Total" OnPageChanged="ChangePageAsync" />
}

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? QueryStatus { get; set; }
    [SupplyParameterFromQuery(Name = "hostId")] public string? QueryHostId { get; set; }

    private const int PageSize = 20;
    private PagedResult<AlertDto>? _result;
    private IReadOnlyList<HostDto> _hosts = Array.Empty<HostDto>();

    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private string _levelFilter = string.Empty;
    private string _typeFilter = string.Empty;
    private string _hostFilter = string.Empty;
    private string _windowFilter = "all";
    private string _quickPreset = string.Empty;
    private int _page = 1;
    private bool _loading = true;
    private bool _purging;
    private string? _error;

    private IEnumerable<AlertDto> FilteredClientItems =>
        _result is null
            ? Enumerable.Empty<AlertDto>()
            : (_quickPreset == "no-tamper"
                ? _result.Items.Where(a => a.ThreatType != ThreatType.Tampering)
                : _result.Items);

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(QueryStatus)) _statusFilter = QueryStatus;
        if (!string.IsNullOrWhiteSpace(QueryHostId)) _hostFilter = QueryHostId;

        Hub.AlertRaised += OnAlertLiveChanged;
        Hub.AlertUpdated += OnAlertLiveChanged;

        try
        {
            _hosts = await Api.GetHostsAsync();
        }
        catch { }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            AlertStatus? status = Enum.TryParse<AlertStatus>(_statusFilter, true, out var s) ? s : null;
            ThreatLevel? level = Enum.TryParse<ThreatLevel>(_levelFilter, true, out var l) ? l : null;
            ThreatType? type = Enum.TryParse<ThreatType>(_typeFilter, true, out var t) ? t : null;
            DateTimeOffset? from = _windowFilter switch
            {
                "24h" => DateTimeOffset.UtcNow.AddHours(-24),
                "7d" => DateTimeOffset.UtcNow.AddDays(-7),
                "30d" => DateTimeOffset.UtcNow.AddDays(-30),
                _ => null
            };

            _result = await Api.GetAlertsAsync(
                status: status,
                level: level,
                type: type,
                hostId: string.IsNullOrWhiteSpace(_hostFilter) ? null : _hostFilter,
                search: string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
                from: from,
                page: _page,
                pageSize: PageSize);
        }
        catch (SentinelApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ApplyFiltersAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task ResetFiltersAsync()
    {
        _search = string.Empty;
        _statusFilter = string.Empty;
        _levelFilter = string.Empty;
        _typeFilter = string.Empty;
        _hostFilter = string.Empty;
        _windowFilter = "all";
        _quickPreset = string.Empty;
        _page = 1;
        return LoadAsync();
    }

    private Task ApplyQuickPresetAsync(string preset)
    {
        _quickPreset = preset;
        switch (preset)
        {
            case "open-crit":
                _statusFilter = nameof(AlertStatus.Open);
                _levelFilter = nameof(ThreatLevel.Critical);
                break;
            case "open-high":
                _statusFilter = nameof(AlertStatus.Open);
                _levelFilter = nameof(ThreatLevel.High);
                break;
            case "no-tamper":
                _statusFilter = string.Empty;
                _levelFilter = string.Empty;
                break;
            default:
                _statusFilter = string.Empty;
                _levelFilter = string.Empty;
                break;
        }
        _page = 1;
        return LoadAsync();
    }

    private async Task PurgeDuplicatesAsync()
    {
        _purging = true;
        try
        {
            var res = await Api.PurgeDuplicateAlertsAsync();
            Toasts.Success("Alertes dédupliquées", $"{res.AlertsResolved} doublon(s) archivé(s) ({res.RemainingOpenAlerts} alerte(s) distincte(s) ouverte(s)).");
            await LoadAsync();
        }
        catch (SentinelApiException ex)
        {
            Toasts.Danger("Échec du nettoyage", ex.Message);
        }
        finally
        {
            _purging = false;
        }
    }

    private Task ChangePageAsync(int nextPage)
    {
        _page = nextPage;
        return LoadAsync();
    }

    private Task OnSearchKeyDown(KeyboardEventArgs e) =>
        e.Key == "Enter" ? ApplyFiltersAsync() : Task.CompletedTask;

    private void OnAlertLiveChanged(AlertDto alert) => _ = InvokeAsync(async () =>
    {
        if (_page == 1 && !_loading)
        {
            await LoadAsync();
            StateHasChanged();
        }
    });

    public void Dispose()
    {
        Hub.AlertRaised -= OnAlertLiveChanged;
        Hub.AlertUpdated -= OnAlertLiveChanged;
    }
}
