@page "/graph"
@page "/graph/{ClusterId:guid}"
@inject SentinelApiClient Api
@inject LiveHubClient Hub
@inject ThemeService Theme
@inject ToastService Toasts
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Arbre &amp; Flux de corrélation — SENTINEL</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Arbre causal &amp; Flux de corrélation temps réel</h1>
        <p class="page-subtitle">Vue hiérarchique claire (Racines → Acteurs → Processus → Événements dédupliqués → Cibles → Alertes) avec distinction des flux directs et indirects</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn @(_liveAutoRefresh ? "btn-emerald" : "")" @onclick="ToggleLiveStream">
            @(_liveAutoRefresh ? "● Flux temps réel actif" : "⏸ Flux en pause")
        </button>
        <button type="button" class="btn" @onclick='() => Nav.NavigateTo("/scan-audit")'>⚡ Simuler / Scanner</button>
        <button type="button" class="btn" @onclick="ExportPngAsync" disabled="@(_graph is null || _graph.Nodes.Count == 0)">Exporter PNG</button>
        <button type="button" class="btn btn-primary" @onclick="LoadGraphAsync" disabled="@_loading">
            @(_loading ? "Chargement…" : "Actualiser")
        </button>
    </div>
</div>

<ErrorBanner Message="@_error" OnRetry="LoadGraphAsync" />

<!-- Sélecteur de mode visuel + recherche instantanée + filtres avancés -->
<div class="filter-bar" style="gap:12px;">
    <div class="field search-field" style="min-width:220px;flex:1.4;">
        <label class="field-label">Recherche instantanée dans l'arbre</label>
        <input class="input" placeholder="Processus, IP, domaine, utilisateur, T1059…"
               @bind="_searchQuery" @bind:event="oninput" @bind:after="ApplyClientFilterAsync" />
    </div>

    <div class="field">
        <label class="field-label">Mode de visualisation</label>
        <select class="select" @bind="_viewMode" @bind:after="OnViewModeChangedAsync">
            <option value="tree-lr">🌳 Arbre causal (Racines → Feuilles)</option>
            <option value="tree-tb">🌲 Arbre hiérarchique (Haut → Bas)</option>
            <option value="stream">⚡ Flux chronologique temps réel</option>
            <option value="concentric">🎯 Concentrique par niveau</option>
            <option value="cose">🕸️ Réseau organique</option>
        </select>
    </div>

    <div class="field">
        <label class="field-label">Type de flux</label>
        <select class="select" @bind="_flowMode" @bind:after="ApplyClientFilterAsync">
            <option value="all">Directs + Indirects</option>
            <option value="direct">Flux causaux directs (─▶)</option>
            <option value="indirect">Corrélations indirectes (- -▶)</option>
        </select>
    </div>

    <div class="field">
        <label class="field-label">Fenêtre</label>
        <select class="select" @bind="_window" @bind:after="LoadGraphAsync">
            <option value="15m">15 dernières min</option>
            <option value="1h">Dernière heure</option>
            <option value="6h">6 dernières heures</option>
            <option value="24h">24 dernières heures</option>
            <option value="7d">7 derniers jours</option>
        </select>
    </div>

    <div class="field">
        <label class="field-label">Score min : <strong class="mono text-cyan">@_minScore</strong></label>
        <input type="range" class="range-slider" min="0" max="90" step="5"
               @bind="_minScore" @bind:after="LoadGraphAsync" />
    </div>

    <div class="field">
        <label class="field-label">Poste</label>
        <select class="select" @bind="_hostFilter" @bind:after="LoadGraphAsync">
            <option value="">Tous les postes</option>
            @foreach (var h in _hosts)
            {
                <option value="@h.HostId">@h.MachineName</option>
            }
        </select>
    </div>

    <div class="field">
        <label class="field-label">Cluster / Incident</label>
        <select class="select" @bind="_selectedClusterKey" @bind:after="OnClusterFilterChangedAsync">
            <option value="">Tous (@(_graph?.Clusters.Count ?? 0))</option>
            @if (_graph is not null)
            {
                @foreach (var c in _graph.Clusters.OrderByDescending(x => x.Score))
                {
                    <option value="@c.Id">@(c.ChainName ?? $"Incident {c.Id.ToString()[..6]}") — @c.Score/100</option>
                }
            }
        </select>
    </div>

    <div class="field" style="flex:0 0 auto;min-width:auto;">
        <label class="field-label">Bruit système</label>
        <button type="button" class="btn btn-sm @(_hideSystemNoise ? "btn-amber" : "")" @onclick="ToggleNoiseAsync" title="Masque les événements répétitifs de maintenance système">
            @(_hideSystemNoise ? "Bruit masqué ✓" : "Tout afficher")
        </button>
    </div>
</div>

<div class="graph-workspace">
    <div class="graph-stage">
        <div class="graph-legend" aria-label="Légende de l'arbre causal">
            <span class="legend-item"><span class="legend-swatch" style="background:#6366f1;"></span>Racine Poste</span>
            <span class="legend-item"><span class="legend-swatch" style="background:#10b981;"></span>Compte / USB</span>
            <span class="legend-item"><span class="legend-swatch" style="background:#8b5cf6;"></span>Processus</span>
            <span class="legend-item"><span class="legend-swatch" style="background:#0ea5e9;"></span>Événement (×N)</span>
            <span class="legend-item"><span class="legend-swatch" style="background:#06b6d4;"></span>Domaine / IP / Fichier</span>
            <span class="legend-item"><span class="legend-swatch" style="background:#ef4444;"></span>Alerte / Menace</span>
            <span class="legend-item" style="margin-left:8px;font-family:Consolas,monospace;color:#38bdf8;">──▶ Direct</span>
            <span class="legend-item" style="font-family:Consolas,monospace;color:#a78bfa;">- -▶ Indirect</span>
        </div>

        @if (_viewMode == "stream")
        {
            <!-- Vue Flux Chronologique & Arborescence Interactive HTML -->
            <div style="height:100%;overflow-y:auto;padding:52px 20px 24px;">
                @if (_graph is null || _graph.Nodes.Count == 0)
                {
                    <EmptyState Title="Aucun flux dans cette fenêtre"
                                Subtitle="Lancez un scénario de démonstration ou élargissez la fenêtre temporelle." />
                }
                else
                {
                    <div class="stack-md">
                        @foreach (var hostGroup in GetHostTrees())
                        {
                            <div class="card" style="border-left:4px solid #6366f1;">
                                <div class="row-wrap" style="justify-content:space-between;margin-bottom:12px;">
                                    <div class="row-wrap" style="gap:8px;">
                                        <span class="badge" style="background:rgba(99,102,241,0.18);color:#818cf8;">RACINE POSTE</span>
                                        <strong class="mono" style="font-size:15px;">@hostGroup.HostLabel</strong>
                                    </div>
                                    <span class="text-muted mono" style="font-size:12px;">@hostGroup.Items.Count élément(s) dans le flux</span>
                                </div>

                                <div class="event-timeline">
                                    @foreach (var item in hostGroup.Items)
                                    {
                                        <div class="timeline-item" style="--dot-color:@UiFormatters.ThreatLevelHex(item.Level);cursor:pointer;"
                                             @onclick="() => SelectNodeDirect(item)">
                                            <div class="row-wrap" style="justify-content:space-between;">
                                                <div class="row-wrap" style="gap:8px;">
                                                    @if (item.Timestamp.HasValue)
                                                    {
                                                        <span class="mono text-muted" style="font-size:11.5px;">@item.Timestamp.Value.ToLocalTime().ToString("HH:mm:ss")</span>
                                                    }
                                                    <span class="badge">@UiFormatters.GraphNodeTypeLabel(item.Type)</span>
                                                    <strong style="font-size:13px;">@item.Label</strong>
                                                </div>
                                                <div class="row-wrap" style="gap:8px;">
                                                    <SeverityBadge Level="item.Level" />
                                                    <span class="mono" style="font-size:12px;font-weight:700;">@item.Score/100</span>
                                                </div>
                                            </div>
                                            @if (item.Data.TryGetValue("justification", out var just) && !string.IsNullOrWhiteSpace(just))
                                            {
                                                <div class="text-secondary" style="font-size:12px;margin-top:4px;">@just</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            @if (_graph is not null && _graph.Nodes.Count == 0 && !_loading)
            {
                <div style="height:100%;display:grid;place-items:center;">
                    <EmptyState Title="Aucun nœud à afficher"
                                Subtitle="Abaissez le score minimum, élargissez la fenêtre temporelle ou lancez une simulation en direct." />
                </div>
            }

            <div id="sentinel-cy-container" class="graph-canvas"></div>

            <div class="graph-floating-controls">
                <button type="button" class="btn btn-sm" title="Zoom avant" @onclick="ZoomInAsync">＋</button>
                <button type="button" class="btn btn-sm" title="Zoom arrière" @onclick="ZoomOutAsync">－</button>
                <button type="button" class="btn btn-sm" title="Ajuster l'arbre à l'écran" @onclick="FitAsync">Ajuster</button>
                <button type="button" class="btn btn-sm" title="Réinitialiser la mise en surbrillance" @onclick="ResetHighlightAsync">Réinitialiser</button>
                @if (!string.IsNullOrWhiteSpace(_selectedClusterKey))
                {
                    <button type="button" class="btn btn-sm btn-violet" @onclick="ClearClusterFocusAsync">Tous les incidents</button>
                }
            </div>
        }
    </div>

    <aside class="graph-inspector">
        @if (_selectedNode is not null)
        {
            <div class="row-wrap" style="justify-content:space-between;">
                <span class="badge" style="background:var(--accent-cyan-soft);color:var(--accent-cyan);">
                    @UiFormatters.GraphNodeTypeLabel(_selectedNode.Type)
                </span>
                <SeverityBadge Level="_selectedNode.Level" />
            </div>
            <h3 style="margin:0;font-size:15px;word-break:break-word;">@_selectedNode.Label</h3>
            <ScoreBar Score="_selectedNode.Score" />

            @if (_selectedNode.Data.TryGetValue("occurrences", out var occ) && occ != "1")
            {
                <div class="badge badge-amber">Événement dédupliqué : @occ occurrences regroupées</div>
            }

            @if (_selectedNode.Timestamp.HasValue)
            {
                <div class="mono text-muted" style="font-size:12px;">Dernière observation : @UiFormatters.FormatDateTime(_selectedNode.Timestamp.Value)</div>
            }

            <!-- Connexions entrantes & sortantes (navigation d'arbre) -->
            var inEdges = GetIncomingEdges(_selectedNode.Id);
            var outEdges = GetOutgoingEdges(_selectedNode.Id);
            @if (inEdges.Count > 0 || outEdges.Count > 0)
            {
                <div class="card-elevated stack-sm" style="padding:10px 12px;font-size:12px;">
                    <div class="field-label">Relations dans l'arbre</div>
                    @foreach (var (edge, neighbor) in inEdges.Take(5))
                    {
                        <div class="row-wrap" style="justify-content:space-between;cursor:pointer;" @onclick="() => SelectNodeDirect(neighbor)">
                            <span class="text-muted">← @(edge.Label ?? edge.Type.ToString())</span>
                            <strong class="mono text-cyan truncate" style="max-width:155px;">@neighbor.Label</strong>
                        </div>
                    }
                    @foreach (var (edge, neighbor) in outEdges.Take(5))
                    {
                        <div class="row-wrap" style="justify-content:space-between;cursor:pointer;" @onclick="() => SelectNodeDirect(neighbor)">
                            <span class="text-muted">→ @(edge.Label ?? edge.Type.ToString())</span>
                            <strong class="mono text-emerald truncate" style="max-width:155px;">@neighbor.Label</strong>
                        </div>
                    }
                </div>
            }

            @if (TryMapEntityKind(_selectedNode.Type, out var entityKind))
            {
                <a class="btn btn-sm btn-primary" href="@UiFormatters.EntityDetailHref(entityKind, _selectedNode.Label)">
                    Ouvrir la fiche @UiFormatters.EntityKindLabel(entityKind) →
                </a>
            }

            @if (_selectedNode.Data.Count > 0)
            {
                <div>
                    <div class="field-label" style="margin-bottom:6px;">Détails techniques complets</div>
                    <div class="stack-sm" style="gap:6px;">
                        @foreach (var kv in _selectedNode.Data.Where(x => x.Key != "rank"))
                        {
                            <div class="card-elevated" style="padding:8px 10px;">
                                <div class="mono text-muted" style="font-size:10.5px;">@kv.Key</div>
                                <div class="mono" style="font-size:12px;word-break:break-all;">@kv.Value</div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_selectedNode.ClusterId.HasValue && FindCluster(_selectedNode.ClusterId.Value) is { } parentCluster)
            {
                <div class="card-elevated stack-sm">
                    <div class="field-label">Incident corrélé parent</div>
                    <div style="font-weight:700;">@(parentCluster.ChainName ?? $"Cluster {parentCluster.Id.ToString()[..8]}")</div>
                    <ScoreBar Score="parentCluster.Score" />
                    <button type="button" class="btn btn-sm btn-violet" @onclick="() => FocusClusterAsync(parentCluster)">
                        Inspecter l'incident &amp; analyse IA
                    </button>
                </div>
            }
        }
        else if (_selectedCluster is not null)
        {
            <div class="row-wrap" style="justify-content:space-between;">
                <span class="badge" style="background:var(--accent-violet-soft);color:var(--accent-violet);">Incident corrélé</span>
                <SeverityBadge Level="_selectedCluster.Level" />
            </div>
            <h3 style="margin:0;font-size:16px;">@(_selectedCluster.ChainName ?? $"Cluster {_selectedCluster.Id.ToString()[..8]}")</h3>
            <ScoreBar Score="_selectedCluster.Score" />

            <div class="card-elevated" style="font-size:12.5px;">
                <div class="row-wrap" style="justify-content:space-between;">
                    <span class="text-secondary">Score max individuel</span>
                    <strong class="mono">@_selectedCluster.MaxEventScore</strong>
                </div>
                <div class="row-wrap" style="justify-content:space-between;margin-top:4px;">
                    <span class="text-secondary">Gain de corrélation</span>
                    <strong class="mono text-emerald">+@(Math.Max(0, _selectedCluster.Score - _selectedCluster.MaxEventScore)) pts</strong>
                </div>
                <div class="row-wrap" style="justify-content:space-between;margin-top:4px;">
                    <span class="text-secondary">Événements reliés</span>
                    <strong class="mono">@_selectedCluster.EventCount</strong>
                </div>
            </div>

            <button type="button" class="btn btn-sm btn-primary" @onclick="() => RunClusterAiAnalysisAsync(_selectedCluster.Id)" disabled="@_analyzingAi">
                @(_analyzingAi ? "Analyse Qwen IA en cours…" : "✨ Générer Diagnostic & Plan d'Action IA (Qwen)")
            </button>

            @if (_clusterAiAnalysis is not null)
            {
                <div class="explain-box" style="padding:12px;border-left:3px solid var(--accent-cyan);">
                    <div class="row-wrap" style="justify-content:space-between;margin-bottom:4px;">
                        <strong style="font-size:12px;color:var(--accent-cyan);">Diagnostic IA (@_clusterAiAnalysis.ModelUsed)</strong>
                        <span class="mono text-muted" style="font-size:11px;">@_clusterAiAnalysis.LatencyMs.ToString("F0") ms</span>
                    </div>
                    <div style="font-size:12px;line-height:1.45;margin-bottom:6px;">@_clusterAiAnalysis.ExecutiveSummary</div>
                    <div style="font-size:11.5px;color:var(--text-secondary);margin-bottom:6px;"><strong>Cause probable :</strong> @_clusterAiAnalysis.RootCauseHypothesis</div>
                    <div class="field-label" style="margin-bottom:3px;">Plan d'action immédiat :</div>
                    <ul style="margin:0;padding-left:16px;font-size:11.5px;line-height:1.45;">
                        @foreach (var step in _clusterAiAnalysis.ImmediateActions)
                        {
                            <li>@step</li>
                        }
                    </ul>
                </div>
            }

            <div class="explain-box" style="padding:12px;">
                <div class="field-label" style="margin-bottom:4px;">Récit chronologique &amp; Justification</div>
                <div style="font-size:12.5px;line-height:1.5;">@(!string.IsNullOrWhiteSpace(_clusterNarrative?.Narrative) ? _clusterNarrative.Narrative : _selectedCluster.Justification)</div>
                @if (_clusterNarrative is not null && _clusterNarrative.ChainProbability > 0)
                {
                    <div class="mono text-cyan" style="font-size:11.5px;margin-top:6px;">Probabilité markovienne : @_clusterNarrative.ChainProbability.ToString("P0")</div>
                }
            </div>

            @if (_clusterActions.Count > 0)
            {
                <div>
                    <div class="field-label" style="margin-bottom:4px;">Actions associées (annulation 1 clic)</div>
                    <div class="stack-sm" style="gap:6px;">
                        @foreach (var act in _clusterActions.Take(4))
                        {
                            <div class="card-elevated" style="padding:8px 10px;font-size:12px;">
                                <div class="row-wrap" style="justify-content:space-between;align-items:center;">
                                    <span class="mono">@act.Type (@act.Target)</span>
                                    @if (act.Reversible && act.Status == ActionStatus.Executed)
                                    {
                                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => UndoActionAsync(act)">Annuler</button>
                                    }
                                    else
                                    {
                                        <span class="badge status-fp">@act.Status</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div>
                <div class="field-label" style="margin-bottom:4px;">MITRE ATT&amp;CK</div>
                <MitreChips Techniques="_selectedCluster.MitreTechniques" />
            </div>

            <a href="/alerts" class="btn btn-sm btn-primary">Voir les alertes liées →</a>
        }
        else if (_selectedEdge is not null)
        {
            <span class="badge sev-low">@(_selectedEdge.Type is GraphEdgeType.Sequence or GraphEdgeType.SameEntity or GraphEdgeType.SameDomain or GraphEdgeType.SameWindow or GraphEdgeType.SameHash or GraphEdgeType.SameAnomalyType ? "Flux indirect (corrélation)" : "Flux causal direct")</span>
            <h3 style="margin:0;font-size:15px;" class="mono">@(_selectedEdge.Label ?? UiFormatters.GraphEdgeTypeLabel(_selectedEdge.Type))</h3>
            <div class="card-elevated stack-sm" style="font-size:12px;">
                <div><span class="text-muted">Relation :</span> <strong class="mono">@UiFormatters.GraphEdgeTypeLabel(_selectedEdge.Type)</strong></div>
                <div><span class="text-muted">Origine :</span> <span class="mono">@_selectedEdge.Source</span></div>
                <div><span class="text-muted">Destination :</span> <span class="mono">@_selectedEdge.Target</span></div>
                <div><span class="text-muted">Force du lien :</span> <strong class="mono">@_selectedEdge.Weight.ToString("0.00")</strong></div>
            </div>
        }
        else
        {
            <div class="card-header" style="margin-bottom:4px;">
                <div>
                    <h3 class="card-title">Explorateur d'incidents</h3>
                    <p class="card-subtitle">Cliquez sur un nœud de l'arbre pour tracer toute sa branche causale (racine → cible)</p>
                </div>
            </div>

            @if (_graph is not null)
            {
                <div class="row-wrap" style="justify-content:space-between;font-size:12px;">
                    <span class="text-secondary">Nœuds : <strong class="mono">@_graph.Nodes.Count</strong></span>
                    <span class="text-secondary">Flux : <strong class="mono">@_graph.Edges.Count</strong></span>
                    <span class="text-secondary">Incidents : <strong class="mono">@_graph.Clusters.Count</strong></span>
                </div>

                @if (_graph.Clusters.Count == 0)
                {
                    <p class="text-muted" style="font-size:12.5px;">Aucun cluster corrélé sur cette période.</p>
                }
                else
                {
                    <div class="stack-sm">
                        @foreach (var c in _graph.Clusters.OrderByDescending(x => x.Score).Take(12))
                        {
                            <div class="card-elevated" style="cursor:pointer;" @onclick="() => FocusClusterAsync(c)">
                                <div class="row-wrap" style="justify-content:space-between;margin-bottom:4px;">
                                    <strong style="font-size:13px;">@(c.ChainName ?? $"Incident {c.Id.ToString()[..6]}")</strong>
                                    <SeverityBadge Level="c.Level" />
                                </div>
                                <ScoreBar Score="c.Score" />
                                <div class="text-muted" style="font-size:11.5px;margin-top:6px;">
                                    @c.EventCount év. reliés • @UiFormatters.ThreatTypeLabel(c.DominantType)
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }
    </aside>
</div>

@code {
    [Parameter] public Guid? ClusterId { get; set; }

    private GraphDto? _graph;
    private IReadOnlyList<HostDto> _hosts = Array.Empty<HostDto>();
    private DotNetObjectReference<Graph>? _dotNetRef;

    private string _window = "24h";
    private int _minScore = 25;
    private string _hostFilter = string.Empty;
    private string _selectedClusterKey = string.Empty;
    private string _viewMode = "tree-lr";
    private string _flowMode = "all";
    private string _searchQuery = string.Empty;
    private bool _hideSystemNoise = true;
    private bool _liveAutoRefresh = true;
    private bool _loading = true;
    private bool _needsRender;
    private bool _analyzingAi;
    private string? _error;

    private GraphNodeDto? _selectedNode;
    private GraphEdgeDto? _selectedEdge;
    private ClusterDto? _selectedCluster;
    private ClusterNarrativeDto? _clusterNarrative;
    private AiIncidentAnalysisDto? _clusterAiAnalysis;
    private List<ActionTicketDto> _clusterActions = new();

    private Guid? _lastRouteClusterId;
    private DateTimeOffset _lastLiveReload = DateTimeOffset.MinValue;

    private sealed record HostTreeGroup(string HostLabel, IReadOnlyList<GraphNodeDto> Items);

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        Theme.ThemeChanged += OnThemeChanged;
        Hub.EventScored += OnLiveEvent;
        Hub.ClusterUpdated += OnLiveCluster;
        _lastRouteClusterId = ClusterId;

        if (ClusterId.HasValue)
        {
            _selectedClusterKey = ClusterId.Value.ToString();
            _minScore = 0;
            _hideSystemNoise = false;
        }

        try { _hosts = await Api.GetHostsAsync(); } catch { }
        await LoadGraphAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ClusterId != _lastRouteClusterId)
        {
            _lastRouteClusterId = ClusterId;
            _selectedClusterKey = ClusterId?.ToString() ?? string.Empty;
            if (ClusterId.HasValue)
            {
                _minScore = 0;
                _hideSystemNoise = false;
            }
            await LoadGraphAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsRender && _graph is not null && _viewMode != "stream")
        {
            _needsRender = false;
            await RenderCytoscapeAsync();
            await ApplyClientFilterAsync();
        }
    }

    private async Task LoadGraphAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var from = _window switch
            {
                "15m" => DateTimeOffset.UtcNow.AddMinutes(-15),
                "1h" => DateTimeOffset.UtcNow.AddHours(-1),
                "6h" => DateTimeOffset.UtcNow.AddHours(-6),
                "7d" => DateTimeOffset.UtcNow.AddDays(-7),
                _ => DateTimeOffset.UtcNow.AddHours(-24)
            };

            Guid? filterCluster = Guid.TryParse(_selectedClusterKey, out var cid) ? cid : null;

            _graph = await Api.GetGraphAsync(
                from: from,
                to: DateTimeOffset.UtcNow,
                hostId: string.IsNullOrWhiteSpace(_hostFilter) ? null : _hostFilter,
                minScore: _minScore,
                clusterId: filterCluster,
                limit: 220);

            _selectedCluster = filterCluster.HasValue ? FindCluster(filterCluster.Value) : _selectedCluster;
            if (_selectedCluster is not null)
            {
                await LoadClusterInspectorDetailsAsync(_selectedCluster);
            }
            _needsRender = true;
        }
        catch (SentinelApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RenderCytoscapeAsync()
    {
        if (_graph is null || _dotNetRef is null || _viewMode == "stream") return;
        try
        {
            var payload = new
            {
                nodes = _graph.Nodes.Select(n => new
                {
                    id = n.Id,
                    type = n.Type.ToString(),
                    label = n.Label,
                    score = n.Score,
                    level = n.Level.ToString(),
                    rank = n.Data.TryGetValue("rank", out var rStr) && int.TryParse(rStr, out var rVal) ? rVal : 3,
                    category = n.Data.GetValueOrDefault("category") ?? string.Empty,
                    mitre = n.Data.GetValueOrDefault("mitre") ?? string.Empty,
                    clusterId = n.ClusterId?.ToString()
                }),
                edges = _graph.Edges.Select(e => new
                {
                    id = e.Id,
                    source = e.Source,
                    target = e.Target,
                    type = e.Type.ToString(),
                    weight = e.Weight,
                    label = e.Label ?? UiFormatters.GraphEdgeTypeLabel(e.Type)
                }),
                clusters = _graph.Clusters.Select(c => new
                {
                    id = c.Id.ToString(),
                    score = c.Score,
                    level = c.Level.ToString(),
                    chainName = c.ChainName
                })
            };

            await JS.InvokeVoidAsync("sentinelGraph.render", "sentinel-cy-container", payload, _viewMode, false, _dotNetRef);
        }
        catch { }
    }

    private async Task OnViewModeChangedAsync()
    {
        if (_viewMode == "stream")
        {
            try { await JS.InvokeVoidAsync("sentinelGraph.destroy"); } catch { }
            return;
        }
        _needsRender = true;
        StateHasChanged();
    }

    private async Task ApplyClientFilterAsync()
    {
        if (_viewMode == "stream") return;
        try
        {
            await JS.InvokeVoidAsync("sentinelGraph.applyFilter", new
            {
                search = _searchQuery,
                nodeType = "",
                flowMode = _flowMode,
                hideSystemNoise = _hideSystemNoise
            });
        }
        catch { }
    }

    private async Task ToggleNoiseAsync()
    {
        _hideSystemNoise = !_hideSystemNoise;
        await ApplyClientFilterAsync();
    }

    private void ToggleLiveStream() => _liveAutoRefresh = !_liveAutoRefresh;

    private void OnLiveEvent(EventDto _) => TriggerDebouncedLiveReload();
    private void OnLiveCluster(ClusterDto _) => TriggerDebouncedLiveReload();

    private void TriggerDebouncedLiveReload()
    {
        if (!_liveAutoRefresh || _loading) return;
        var now = DateTimeOffset.UtcNow;
        if ((now - _lastLiveReload) < TimeSpan.FromSeconds(2)) return;
        _lastLiveReload = now;
        _ = InvokeAsync(async () =>
        {
            await LoadGraphAsync();
            StateHasChanged();
        });
    }

    private Task OnClusterFilterChangedAsync() => LoadGraphAsync();

    private async Task FocusClusterAsync(ClusterDto cluster)
    {
        _selectedCluster = cluster;
        _selectedNode = null;
        _selectedEdge = null;
        _clusterAiAnalysis = null;
        _selectedClusterKey = cluster.Id.ToString();
        await LoadClusterInspectorDetailsAsync(cluster);
        if (_viewMode != "stream")
        {
            try { await JS.InvokeVoidAsync("sentinelGraph.highlightCluster", cluster.Id.ToString()); } catch { }
        }
    }

    private async Task LoadClusterInspectorDetailsAsync(ClusterDto cluster)
    {
        _clusterNarrative = null;
        _clusterActions.Clear();
        try
        {
            _clusterNarrative = await Api.GetClusterNarrativeAsync(cluster.Id);
            var actions = await Api.GetActionsAsync(hostId: cluster.HostId, pageSize: 10);
            _clusterActions = actions.Items.ToList();
        }
        catch { }
    }

    private async Task RunClusterAiAnalysisAsync(Guid clusterId)
    {
        _analyzingAi = true;
        try
        {
            _clusterAiAnalysis = await Api.AnalyzeClusterWithAiAsync(clusterId);
            Toasts.Success("Diagnostic IA prêt", $"Généré par {_clusterAiAnalysis.ModelUsed}.");
        }
        catch (SentinelApiException ex)
        {
            Toasts.Danger("Analyse IA indisponible", ex.Message);
        }
        finally
        {
            _analyzingAi = false;
        }
    }

    private async Task UndoActionAsync(ActionTicketDto action)
    {
        try
        {
            var reverted = await Api.RevertActionAsync(action.Id);
            var idx = _clusterActions.FindIndex(a => a.Id == action.Id);
            if (idx >= 0) _clusterActions[idx] = reverted;
            Toasts.Success("Action annulée", $"{action.Type} sur {action.Target} révoquée.");
        }
        catch (SentinelApiException ex)
        {
            Toasts.Danger("Erreur", ex.Message);
        }
    }

    private async Task ClearClusterFocusAsync()
    {
        _selectedClusterKey = string.Empty;
        _selectedCluster = null;
        _clusterAiAnalysis = null;
        await LoadGraphAsync();
    }

    private void SelectNodeDirect(GraphNodeDto node)
    {
        _selectedNode = node;
