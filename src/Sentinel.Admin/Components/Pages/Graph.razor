    [JSInvokable]
    public void OnNodeSelected(string nodeId)
    {
        _selectedNode = _graph?.Nodes.FirstOrDefault(n => n.Id == nodeId);
        _selectedEdge = null;
        _selectedCluster = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnEdgeSelected(string edgeId)
    {
        _selectedEdge = _graph?.Edges.FirstOrDefault(e => e.Id == edgeId);
        _selectedNode = null;
        _selectedCluster = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnClusterSelected(string clusterId)
    {
        if (Guid.TryParse(clusterId, out var cid))
        {
            _selectedCluster = FindCluster(cid);
            _selectedNode = null;
            _selectedEdge = null;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnCanvasCleared()
    {
        _selectedNode = null;
        _selectedEdge = null;
        _selectedCluster = null;
        StateHasChanged();
    }

    private ClusterDto? FindCluster(Guid id) => _graph?.Clusters.FirstOrDefault(c => c.Id == id);

    private static bool TryMapEntityKind(GraphNodeType type, out EntityKind kind)
    {
        switch (type)
        {
            case GraphNodeType.Host: kind = EntityKind.Host; return true;
            case GraphNodeType.User: kind = EntityKind.User; return true;
            case GraphNodeType.Domain: kind = EntityKind.Domain; return true;
            case GraphNodeType.Process: kind = EntityKind.Process; return true;
            case GraphNodeType.File: kind = EntityKind.File; return true;
            case GraphNodeType.Device: kind = EntityKind.Device; return true;
            case GraphNodeType.Ip: kind = EntityKind.Ip; return true;
            default: kind = default; return false;
        }
    }

