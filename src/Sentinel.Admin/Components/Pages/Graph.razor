    }

    private IReadOnlyList<(GraphEdgeDto Edge, GraphNodeDto Node)> GetIncomingEdges(string nodeId)
    {
        if (_graph is null) return Array.Empty<(GraphEdgeDto, GraphNodeDto)>();
        var map = _graph.Nodes.ToDictionary(n => n.Id, StringComparer.OrdinalIgnoreCase);
        return _graph.Edges
            .Where(e => string.Equals(e.Target, nodeId, StringComparison.OrdinalIgnoreCase) && map.ContainsKey(e.Source))
            .Select(e => (e, map[e.Source]))
            .ToArray();
    }

    private IReadOnlyList<(GraphEdgeDto Edge, GraphNodeDto Node)> GetOutgoingEdges(string nodeId)
    {
        if (_graph is null) return Array.Empty<(GraphEdgeDto, GraphNodeDto)>();
        var map = _graph.Nodes.ToDictionary(n => n.Id, StringComparer.OrdinalIgnoreCase);
        return _graph.Edges
            .Where(e => string.Equals(e.Source, nodeId, StringComparison.OrdinalIgnoreCase) && map.ContainsKey(e.Target))
            .Select(e => (e, map[e.Target]))
            .ToArray();
    }

    private IReadOnlyList<HostTreeGroup> GetHostTrees()
    {
        if (_graph is null) return Array.Empty<HostTreeGroup>();
        var q = _searchQuery.Trim();
        var filtered = _graph.Nodes
            .Where(n => n.Type != GraphNodeType.Host)
            .Where(n => !_hideSystemNoise || !(n.Type == GraphNodeType.Event && n.Data.GetValueOrDefault("category") == "System"))
            .Where(n => string.IsNullOrWhiteSpace(q) || n.Label.Contains(q, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(n => n.Timestamp ?? DateTimeOffset.MinValue)
            .ToList();

        var hosts = _graph.Nodes.Where(n => n.Type == GraphNodeType.Host).Select(n => n.Label).DefaultIfEmpty("Postes surveillés").ToList();
        return [new HostTreeGroup(string.Join(", ", hosts.Take(3)), filtered)];
    }

