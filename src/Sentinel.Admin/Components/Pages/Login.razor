@page "/login"
@layout AuthLayout
@inject SentinelApiClient Api
@inject AdminSessionState Session
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Connexion — SENTINEL</PageTitle>

<div class="auth-card">
    <div class="auth-logo-wrap">
        <ShieldLogo Size="56" />
        <div>
            <h1 style="margin:0;font-size:22px;font-weight:800;letter-spacing:0.06em;">SENTINEL</h1>
            <p class="text-secondary" style="margin:4px 0 0;font-size:13px;">Console d'administration SOC — Authentification 2FA</p>
        </div>
    </div>

    @if (_checkingStatus)
    {
        <div class="stack-sm">
            <div class="skeleton" style="height:40px;"></div>
            <div class="skeleton" style="height:40px;"></div>
            <div class="skeleton" style="height:44px;"></div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="error-banner" style="margin-bottom:16px;padding:10px 12px;">
                <span style="font-size:12.5px;">@_error</span>
                @if (_serverOffline)
                {
                    <button type="button" class="btn btn-sm btn-danger" @onclick="CheckAuthStatusAsync">Réessayer</button>
                }
            </div>
        }

        <form @onsubmit="SubmitAsync" class="stack-md">
            <div class="field">
                <label class="field-label" for="login-user">Identifiant administrateur</label>
                <input id="login-user" class="input" autocomplete="username" placeholder="admin"
                       @bind="_username" required disabled="@_submitting" />
            </div>

            <div class="field">
                <label class="field-label" for="login-pass">Mot de passe</label>
                <input id="login-pass" type="password" class="input" autocomplete="current-password" placeholder="••••••••••••"
                       @bind="_password" required disabled="@_submitting" />
            </div>

            <div class="field">
                <div class="row-between" style="margin-bottom:4px;">
                    <label class="field-label" for="login-totp">Code TOTP (6 chiffres)</label>
                    <button type="button" class="btn btn-xs btn-ghost" @onclick="() => _showKeyHelper = !_showKeyHelper">
                        @(_showKeyHelper ? "Masquer l'assistant clé Base32" : "Utiliser ma clé Base32")
                    </button>
                </div>
                <input id="login-totp" class="input totp-input" inputmode="numeric" maxlength="6"
                       placeholder="000000" autocomplete="one-time-code"
                       @bind="_totpCode" required disabled="@_submitting" />
                <span class="field-hint">Généré par votre application d'authentification (Aegis, Google Authenticator, Bitwarden…).</span>
                @if (_showKeyHelper)
                {
                    <div class="row-gap-sm" style="margin-top:8px;">
                        <input id="login-base32" class="input mono" style="font-size:12px;" placeholder="Collez votre clé Base32 TOTP…" @bind="_base32Secret" />
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="ComputeFromBase32">Calculer</button>
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary btn-lg" style="width:100%;" disabled="@_submitting">
                @if (_submitting)
                {
                    <span>Vérification en cours…</span>
                }
                else
                {
                    <span>Se connecter à la console</span>
                }
            </button>
        </form>

        <div class="text-muted" style="text-align:center;font-size:11.5px;margin-top:20px;">
            Compte administrateur unique • Session chiffrée • Chaque accès est journalisé
        </div>
    }
</div>

@code {
    private bool _checkingStatus = true;
    private bool _submitting;
    private bool _serverOffline;
    private string? _error;

    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _totpCode = string.Empty;
    private bool _showKeyHelper;
    private string _base32Secret = string.Empty;

    private void ComputeFromBase32()
    {
        var code = QrCodeHelper.ComputeTotpCode(_base32Secret);
        if (string.IsNullOrEmpty(code))
        {
            _error = "Clé Base32 invalide.";
            return;
        }
        _error = null;
        _totpCode = code;
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (Session.IsAuthenticated)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }
        await CheckAuthStatusAsync();
    }

    private async Task CheckAuthStatusAsync()
    {
        _checkingStatus = true;
        _error = null;
        _serverOffline = false;
        try
        {
            var status = await Api.GetAuthStatusAsync();
            if (!status.IsConfigured)
            {
                Nav.NavigateTo("/setup", replace: true);
                return;
            }
            if (!string.IsNullOrWhiteSpace(status.Username) && string.IsNullOrWhiteSpace(_username))
            {
                _username = status.Username;
            }
        }
        catch (SentinelApiException ex)
        {
            _serverOffline = ex.IsConnectionFailure;
            _error = ex.Message;
        }
        finally
        {
            _checkingStatus = false;
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        var cleanCode = new string(_totpCode.Where(char.IsDigit).ToArray());
        if (cleanCode.Length != 6)
        {
            _error = "Le code TOTP doit contenir exactement 6 chiffres.";
            return;
        }

        _submitting = true;
        try
        {
            var resp = await Api.LoginAsync(new LoginRequest(_username.Trim(), _password, cleanCode));
            await Session.SetSessionAsync(resp);
            Toasts.Success("Connexion réussie", $"Bienvenue, {resp.Username}.");
            Nav.NavigateTo("/", replace: true);
        }
        catch (SentinelApiException ex)
        {
            _serverOffline = ex.IsConnectionFailure;
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }
}
