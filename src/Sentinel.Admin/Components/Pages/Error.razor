@page "/Error"
@layout AuthLayout

<PageTitle>Erreur — SENTINEL</PageTitle>

<div class="auth-card" style="text-align:center;">
    <div class="auth-logo-wrap">
        <ShieldLogo Size="52" />
        <h1 style="margin:0;font-size:20px;font-weight:800;">Une erreur interne est survenue</h1>
        <p class="text-secondary" style="margin:4px 0 0;font-size:13px;">
            La requête n'a pas pu aboutir. Consultez les journaux locaux de la console si le problème persiste.
        </p>
    </div>
    <a href="/" class="btn btn-primary" style="width:100%;">Retourner à la vue d'ensemble</a>
</div>
