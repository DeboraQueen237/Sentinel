@inherits LayoutComponentBase
@inject AdminSessionState Session
@inject SentinelApiClient Api
@inject LiveHubClient Hub
@inject ThemeService Theme
@inject ToastService Toasts
@inject NavigationManager Nav
@implements IDisposable

@if (!_authChecked)
{
    <div class="auth-shell">
        <div class="auth-card" style="text-align:center;">
            <div class="auth-logo-wrap" style="margin-bottom:12px;">
                <ShieldLogo Size="54" />
                <div class="brand-title" style="font-size:20px;">SENTINEL</div>
                <div class="text-secondary" style="font-size:13px;">Vérification de la session administrateur…</div>
            </div>
            <div class="skeleton" style="height:6px;width:100%;"></div>
        </div>
    </div>
}
else if (Session.IsAuthenticated)
{
    <div class="soc-shell">
        <div class="sidebar-backdrop @(_mobileMenuOpen ? "open" : "")" @onclick="CloseMobileMenu"></div>

        <aside class="soc-sidebar @(_mobileMenuOpen ? "open" : "")" aria-label="Navigation principale">
            <div class="sidebar-brand">
                <ShieldLogo Size="38" />
                <div>
                    <div class="brand-title">SENTINEL</div>
                    <div class="brand-sub">Console EDR / SOC</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-label">Supervision</div>

                <NavLink class="nav-item" href="" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1" /><rect x="14" y="3" width="7" height="5" rx="1" /><rect x="14" y="12" width="7" height="9" rx="1" /><rect x="3" y="16" width="7" height="5" rx="1" /></svg>
                    <span>Vue d'ensemble</span>
                </NavLink>

                <NavLink class="nav-item" href="alerts" @onclick="CloseMobileMenu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    <span>Alertes</span>
                    @if (_activeAlerts > 0)
                    {
                        <span class="nav-badge @(_criticalAlerts == 0 ? "warn" : "")">@_activeAlerts</span>
                    }
                </NavLink>

                <NavLink class="nav-item" href="graph" @onclick="CloseMobileMenu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" /></svg>
                    <span>Graphe de corrélation</span>
                </NavLink>

                <div class="nav-section-label">Investigation & Réponse</div>

                <NavLink class="nav-item" href="entities" @onclick="CloseMobileMenu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg>
                    <span>Fiches Postes & Entités</span>
                </NavLink>

                <NavLink class="nav-item" href="actions" @onclick="CloseMobileMenu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><line x1="9" y1="9" x2="15" y2="15" /><line x1="15" y1="9" x2="9" y2="15" /></svg>
                    <span>Actions & blocages</span>
                    @if (_activeBlocks > 0)
                    {
                        <span class="nav-badge warn">@_activeBlocks</span>
                    }
                </NavLink>

                <div class="nav-section-label">Gouvernance</div>

                <NavLink class="nav-item" href="reports" @onclick="CloseMobileMenu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                    <span>Rapports & Évaluation</span>
                </NavLink>

                <NavLink class="nav-item" href="settings" @onclick="CloseMobileMenu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                    <span>Paramètres</span>
                </NavLink>

                <NavLink class="nav-item" href="audit" @onclick="CloseMobileMenu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="M9 12l2 2 4-4" /></svg>
                    <span>Audit & Intégrité</span>
                </NavLink>
            </nav>

            <div class="sidebar-footer">
                <div class="live-status-row">
                    <span class="live-pill">
                        <span class="pulse-dot @LiveDotCss"></span>
                        <span>@LiveStateText</span>
                    </span>
                    <span class="mono text-muted" style="font-size:11px;">v@(_version)</span>
                </div>
                <div class="live-status-row text-muted" style="font-size:11px;">
                    <span>Serveur local</span>
                    <span class="mono">@(_serverOnline ? "Connecté" : "Hors ligne")</span>
                </div>
            </div>
        </aside>

        <div class="soc-main">
            <header class="soc-topbar">
                <div class="topbar-left">
                    <button type="button" class="mobile-menu-btn" @onclick="ToggleMobileMenu" aria-label="Ouvrir le menu">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
                    </button>
                    <div class="breadcrumb">
                        <span class="breadcrumb-root hide-mobile">SENTINEL</span>
                        <span class="breadcrumb-sep hide-mobile">/</span>
                        <span class="breadcrumb-current">@CurrentSectionLabel</span>
                    </div>
                </div>

                <div class="topbar-right">
                    <a href="/settings" class="status-chip @UiFormatters.OperatingModeCss(_mode) hide-mobile" title="@UiFormatters.OperatingModeDescription(_mode)">
                        <span class="badge-dot"></span>
                        <span>Mode @UiFormatters.OperatingModeLabel(_mode)</span>
                    </a>

                    <span class="status-chip @(_llmAvailable ? "llm-ok" : "llm-off") hide-tablet"
                          title="@(_llmAvailable ? $"IA locale Ollama active : {_llmModel}" : "IA locale Ollama hors ligne (repli règles déterministes)")">
                        <span class="badge-dot"></span>
                        <span>IA : @(_llmAvailable ? _llmModel : "Hors ligne")</span>
                    </span>

                    <button type="button" class="btn btn-icon" title="Basculer le thème clair / sombre" @onclick="ToggleThemeAsync">
                        @if (Theme.IsDark)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" /></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
                        }
                    </button>

                    <div class="user-pill hide-mobile" title="Administrateur connecté">
                        <span class="user-avatar">@UserInitials</span>
                        <span>@(Session.Username ?? "Admin")</span>
                    </div>

                    <button type="button" class="btn btn-sm btn-ghost" title="Déconnexion" @onclick="LogoutAsync">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        <span class="hide-tablet">Quitter</span>
                    </button>
                </div>
            </header>

            <main class="soc-content">
                @Body
            </main>
        </div>
    </div>
}

<ToastContainer />

@code {
    private bool _authChecked;
    private bool _mobileMenuOpen;
    private bool _serverOnline = true;
    private int _activeAlerts;
    private int _criticalAlerts;
    private int _activeBlocks;
    private OperatingMode _mode = OperatingMode.Learning;
    private bool _llmAvailable;
    private string _llmModel = "Ollama";
    private string _version = "1.0.0";

    private string UserInitials =>
        string.IsNullOrWhiteSpace(Session.Username)
            ? "AD"
            : Session.Username.Length >= 2
                ? Session.Username[..2].ToUpperInvariant()
                : Session.Username.ToUpperInvariant();

    private string LiveDotCss => Hub.State switch
    {
        LiveConnectionState.Connected => "online",
        LiveConnectionState.Connecting or LiveConnectionState.Reconnecting => "reconnecting",
        _ => "offline"
    };

    private string LiveStateText => Hub.State switch
    {
        LiveConnectionState.Connected => "Flux temps réel actif",
        LiveConnectionState.Connecting => "Connexion temps réel…",
        LiveConnectionState.Reconnecting => "Reconnexion…",
        _ => "Temps réel déconnecté"
    };

    private string CurrentSectionLabel
    {
        get
        {
            var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
            if (string.IsNullOrEmpty(rel)) return "Vue d'ensemble";
            if (rel.StartsWith("alerts/", StringComparison.OrdinalIgnoreCase)) return "Détail de l'alerte";
            if (rel.StartsWith("alerts", StringComparison.OrdinalIgnoreCase)) return "Alertes de sécurité";
            if (rel.StartsWith("graph", StringComparison.OrdinalIgnoreCase)) return "Graphe de corrélation";
            if (rel.StartsWith("entities/", StringComparison.OrdinalIgnoreCase)) return "Fiche d'entité";
            if (rel.StartsWith("entities", StringComparison.OrdinalIgnoreCase)) return "Fiches Postes & Entités";
            if (rel.StartsWith("actions", StringComparison.OrdinalIgnoreCase)) return "Actions & blocages";
            if (rel.StartsWith("reports", StringComparison.OrdinalIgnoreCase)) return "Rapports & Évaluation";
            if (rel.StartsWith("settings", StringComparison.OrdinalIgnoreCase)) return "Paramètres";
            if (rel.StartsWith("audit", StringComparison.OrdinalIgnoreCase)) return "Audit & Intégrité";
            return "Console SOC";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        Hub.StateChanged += OnHubStateChanged;
        Hub.SummaryChanged += OnSummaryChanged;
        Hub.AlertRaised += OnAlertRaised;
        Hub.SettingsChanged += OnSettingsChanged;
        Theme.ThemeChanged += OnThemeChanged;
        Nav.LocationChanged += OnLocationChanged;

        await Session.InitializeAsync();
        await Theme.InitializeAsync();

        if (!Session.IsAuthenticated)
        {
            await RedirectToAuthAsync();
            return;
        }

        _authChecked = true;
        await RefreshShellStatusAsync();
        _ = Hub.EnsureConnectedAsync();
    }

    private async Task RedirectToAuthAsync()
    {
        try
        {
            var status = await Api.GetAuthStatusAsync();
            Nav.NavigateTo(status.IsConfigured ? "/login" : "/setup", replace: true);
        }
        catch
        {
            Nav.NavigateTo("/login", replace: true);
        }
    }

    private async Task RefreshShellStatusAsync()
    {
        try
        {
            var summaryTask = Api.GetDashboardSummaryAsync();
            var healthTask = Api.GetHealthAsync();
            await Task.WhenAll(summaryTask, healthTask);

            ApplySummary(summaryTask.Result);
            var health = healthTask.Result;
            _version = string.IsNullOrWhiteSpace(health.Version) ? "1.0.0" : health.Version;
            _llmAvailable = health.LlmAvailable;
            if (!string.IsNullOrWhiteSpace(health.LlmModel)) _llmModel = health.LlmModel;
            _mode = health.Mode;
            _serverOnline = true;
        }
        catch (SentinelApiException ex) when (ex.IsUnauthorized)
        {
            Nav.NavigateTo("/login", replace: true);
        }
        catch
        {
            _serverOnline = false;
        }
    }

    private void ApplySummary(DashboardSummaryDto summary)
    {
        _activeAlerts = summary.ActiveAlerts;
        _criticalAlerts = summary.CriticalAlerts;
        _activeBlocks = summary.ActiveBlocks;
        _mode = summary.Mode;
        _llmAvailable = summary.LlmAvailable;
        if (!string.IsNullOrWhiteSpace(summary.LlmModel)) _llmModel = summary.LlmModel;
        _serverOnline = true;
    }

    private void OnSessionChanged()
    {
        if (!Session.IsAuthenticated && _authChecked)
        {
            _ = InvokeAsync(() => Nav.NavigateTo("/login", replace: true));
        }
        else
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void OnHubStateChanged(LiveConnectionState state) => _ = InvokeAsync(StateHasChanged);

    private void OnSummaryChanged(DashboardSummaryDto summary)
    {
        ApplySummary(summary);
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnSettingsChanged(SentinelSettings settings)
    {
        _mode = settings.Mode;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnAlertRaised(AlertDto alert)
    {
        _activeAlerts++;
        if (alert.Level == ThreatLevel.Critical) _criticalAlerts++;

        var kind = alert.Level switch
        {
            ThreatLevel.Critical => ToastKind.Danger,
            ThreatLevel.High => ToastKind.Warning,
            _ => ToastKind.Info
        };
        Toasts.Show(
            kind,
            $"Nouvelle alerte {UiFormatters.ThreatLevelLabel(alert.Level)} (score {alert.Score})",
            $"{alert.Title} — {alert.HostId}",
            $"/alerts/{alert.Id}",
            "Ouvrir l'alerte");

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged(string theme) => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _mobileMenuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private Task ToggleThemeAsync() => Theme.ToggleAsync();
    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;
    private void CloseMobileMenu() => _mobileMenuOpen = false;

    private async Task LogoutAsync()
    {
        await Hub.DisconnectAsync();
        await Api.LogoutAsync();
        Toasts.Info("Déconnexion", "Votre session administrateur a été fermée.");
        Nav.NavigateTo("/login", replace: true);
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Hub.StateChanged -= OnHubStateChanged;
        Hub.SummaryChanged -= OnSummaryChanged;
        Hub.AlertRaised -= OnAlertRaised;
        Hub.SettingsChanged -= OnSettingsChanged;
        Theme.ThemeChanged -= OnThemeChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
