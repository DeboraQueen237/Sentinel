@inject ToastService Toasts
@inject NavigationManager Nav
@implements IDisposable

@if (_items.Count > 0)
{
    <div class="toast-stack" role="status" aria-live="polite">
        @foreach (var item in _items)
        {
            <div class="toast-item @ToastCss(item.Kind)" @key="item.Id">
                <div style="flex:1;min-width:0;">
                    <div style="font-weight:700;font-size:13px;color:var(--text-primary);">@item.Title</div>
                    <div style="font-size:12px;color:var(--text-secondary);margin-top:2px;">@item.Message</div>
                    @if (!string.IsNullOrWhiteSpace(item.LinkUrl))
                    {
                        <button type="button" class="btn btn-sm btn-ghost" style="margin-top:6px;padding:3px 6px;color:var(--accent-cyan);"
                                @onclick="() => OpenLink(item)">
                            @(item.LinkLabel ?? "Consulter →")
                        </button>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-ghost" style="padding:2px 6px;" aria-label="Fermer"
                        @onclick="() => Toasts.Dismiss(item.Id)">✕</button>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<ToastItem> _items = Array.Empty<ToastItem>();

    protected override void OnInitialized()
    {
        _items = Toasts.Items;
        Toasts.Changed += OnChanged;
    }

    private void OnChanged()
    {
        _items = Toasts.Items;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OpenLink(ToastItem item)
    {
        Toasts.Dismiss(item.Id);
        if (!string.IsNullOrWhiteSpace(item.LinkUrl))
        {
            Nav.NavigateTo(item.LinkUrl);
        }
    }

    private static string ToastCss(ToastKind kind) => kind switch
    {
        ToastKind.Success => "toast-success",
        ToastKind.Warning => "toast-warning",
        ToastKind.Danger => "toast-danger",
        _ => string.Empty
    };

    public void Dispose()
    {
        Toasts.Changed -= OnChanged;
    }
}
