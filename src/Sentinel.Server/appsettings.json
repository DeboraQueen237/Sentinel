{
  "Sentinel": {
    "ApiPort": 5180,
    "GrpcPort": 5181,
    "UseMtls": true,
    "SessionTtlMinutes": 30,
    "CorsOrigins": [
      "http://127.0.0.1:5200",
      "http://localhost:5200"
    ],
    "ConnectionString": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Grpc": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
