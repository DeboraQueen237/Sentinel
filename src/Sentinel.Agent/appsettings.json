{
  "Agent": {
    "ServerGrpcUrl": "https://localhost:5181",
    "UseMtls": true,
    "HeartbeatIntervalSeconds": 15,
    "BatchSize": 100,
    "BatchFlushIntervalMs": 2000,
    "MaxOutboxEvents": 50000,
    "ChannelCapacity": 4096,
    "IntegrityManifestPath": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Grpc": "Warning"
      }
    }
  }
}
